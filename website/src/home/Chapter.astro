---
import Band from "./Band.astro";
import type { Chapter } from "./chapters.ts";
import Feature from "./Feature.astro";

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
// Features beside their text alternate sides; a band between them doesn't count.
let beside = 0;
---

<section id={chapter.id} class="chapter" aria-labelledby={`${chapter.id}-title`}>
  <header>
    <span class="numeral" lang="ja" aria-hidden="true">{chapter.numeral}</span>
    <div>
      <h2 id={`${chapter.id}-title`}>{chapter.title}</h2>
      <p>{chapter.intro}</p>
    </div>
  </header>
  {
    chapter.features.map((feature) =>
      feature.band ? <Band feature={{ ...feature, band: feature.band }} /> : <Feature feature={feature} flip={beside++ % 2 === 1} />,
    )
  }
</section>

<style>
  header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 6rem var(--gutter) 1rem;
  }

  header::after {
    content: "";
    flex: 1;
    align-self: center;
    height: 1px;
    margin-left: 1rem;
    background: var(--border);
  }

  /* A seal, so the numeral reads as a character rather than as a stroke. */
  .numeral {
    display: grid;
    flex: none;
    place-items: center;
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 0.4rem;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--serif);
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  p {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  @media (max-width: 44rem) {
    header {
      padding-top: 4rem;
    }

    header::after {
      display: none;
    }

    .numeral {
      width: 3.4rem;
      height: 3.4rem;
      font-size: 2rem;
    }
  }
</style>
