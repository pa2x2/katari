---
import Band from "./Band.astro";
import type { Chapter } from "./chapters.ts";
import Feature from "./Feature.astro";

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
// Features beside their text alternate sides; a band between them doesn't count.
let beside = 0;
---

<section id={chapter.id} class="chapter" aria-labelledby={`${chapter.id}-title`}>
  <header style={`--tint-from: ${chapter.tint[0]}; --tint-to: ${chapter.tint[1]}`}>
    <div class="inner">
      <span class="numeral" lang="ja" aria-hidden="true" data-pagefind-ignore>{chapter.numeral}</span>
      <div>
        <h2 id={`${chapter.id}-title`}>{chapter.title}</h2>
        <p>{chapter.intro}</p>
      </div>
      <span class="word" lang="ja" aria-hidden="true" data-pagefind-ignore>{chapter.word}</span>
    </div>
  </header>
  {
    chapter.features.map((feature) =>
      feature.band ? <Band feature={{ ...feature, band: feature.band }} /> : <Feature feature={feature} flip={beside++ % 2 === 1} />,
    )
  }
</section>

<style>
  /* A title page: the chapter's own tint across the window. It is dark in either theme, as the recap band is, so its
     text and seal take the dark theme's colours. */
  header {
    color-scheme: dark;
    margin-top: 4rem;
    background: linear-gradient(160deg, var(--tint-from), var(--tint-to) 70%);
    color: var(--text-strong);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    max-width: var(--page-width);
    min-height: 18rem;
    margin: 0 auto;
    padding: 3rem calc(var(--gutter) + 3rem);
  }

  /* A seal, so the numeral reads as a character rather than as a stroke. */
  .numeral {
    display: grid;
    flex: none;
    place-items: center;
    width: 7rem;
    height: 7rem;
    border-radius: 0.6rem;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--serif);
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
  }

  h2 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.75rem);
  }

  p {
    margin: 0.5rem 0 0;
    color: var(--text);
    font-size: 1.25rem;
  }

  .word {
    margin-left: auto;
    color: var(--accent);
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    writing-mode: vertical-rl;
  }

  @media (max-width: 44rem) {
    header {
      margin-top: 3rem;
    }

    .inner {
      gap: 1.25rem;
      min-height: 11rem;
      padding: 2rem var(--gutter);
    }

    .numeral {
      width: 4rem;
      height: 4rem;
      font-size: 2.3rem;
    }

    p {
      font-size: 1.05rem;
    }

    /* Upright beside the title it would squeeze the title onto three lines. */
    .word {
      display: none;
    }
  }
</style>
