---
/**
 * A feature's screenshots. In a band they stand side by side at one height, whatever their proportions. Beside a
 * feature's text one shows at a time and a button per caption switches to another, so none is covered; the others keep
 * their place behind it, which holds the column at the tallest one's height. On a phone either becomes a row to swipe
 * through.
 */
import { aspectOf } from "../media/aspect.ts";
import { isUpright } from "../media/devices.ts";
import type { Shot } from "./chapters.ts";
import ShotView from "./ShotView.astro";

interface Props {
  shots: Shot[];
  arrangement: "row" | "switch";
}

const { shots, arrangement } = Astro.props;

const isWide = (shot: Shot) => shot.kind === "still" && !isUpright(shot.device ?? "phone");
const aspect = (shot: Shot) =>
  shot.kind === "still" ? aspectOf(shot.image, shot.device ?? "phone") : aspectOf(shot.kind === "compare" ? shot.after : shot.poster, "phone");
const switched = arrangement === "switch" && shots.length > 1;
---

<div class:list={["stack", arrangement, { switched }]} data-zoom-group data-reveal>
  <div class="shots">
    {
      shots.map((shot, index) => (
        <div class:list={["slot", { wide: isWide(shot), current: index === 0 }]} style={`--aspect: ${aspect(shot)}`}>
          <ShotView shot={shot} />
        </div>
      ))
    }
  </div>
  {
    switched && (
      <div class="captions" role="group" aria-label="Screenshots" data-pagefind-ignore>
        {shots.map((shot, index) => (
          <button type="button" aria-pressed={index === 0 ? "true" : "false"}>
            {shot.caption}
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  for (const stack of document.querySelectorAll<HTMLElement>(".stack.switched")) {
    const slots = [...stack.querySelectorAll<HTMLElement>(".slot")];
    const buttons = [...stack.querySelectorAll<HTMLButtonElement>(".captions button")];
    buttons.forEach((button, chosen) =>
      button.addEventListener("click", () => {
        slots.forEach((slot, index) => slot.classList.toggle("current", index === chosen));
        buttons.forEach((other, index) => other.setAttribute("aria-pressed", String(index === chosen)));
      }),
    );
  }
</script>

<style>
  .stack {
    container-type: inline-size;
    /* A frame's padding around its screen, both sides together, which a shared height has to leave room for. */
    --frame: 0.9rem;
  }

  .captions {
    display: none;
  }

  @media (width > 44rem) {
    .row .shots {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: clamp(1rem, 3vw, 2.5rem);
    }

    /* Each starts as wide as the shared height needs, and a narrow page shrinks them all in proportion. */
    .row .slot {
      --row-height: 44rem;
      --shot-width: calc((var(--row-height) - var(--frame)) * var(--aspect) + var(--frame));
      flex: 0 1 var(--shot-width);
      min-width: 0;
    }

    .row .slot > :global(*) {
      --shot-width: 100%;
    }

    /* Every shot takes the same cell, and only the current one shows. */
    .switch .shots {
      display: grid;
      place-items: center;
    }

    .switch .slot {
      grid-area: 1 / 1;
      --shot-width: min(22rem, 62cqi);
    }

    .switch .slot.wide {
      --shot-width: min(44rem, 100cqi);
    }

    .switched .slot:not(.current) {
      visibility: hidden;
    }

    /* The buttons carry the captions; screen readers still read each with its shot. */
    .switched .slot :global(figcaption) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .captions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1.5rem;
    }

    .captions button {
      padding: 0.45rem 1rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: transparent;
      color: var(--text-muted);
      font: inherit;
      font-size: 0.95rem;
      cursor: pointer;
    }

    .captions button:hover {
      color: var(--text-strong);
    }

    .captions button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .captions button[aria-pressed="true"] {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--on-accent);
      font-weight: 600;
    }
  }

  @media (width <= 44rem) {
    .shots {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      margin: 0 calc(-1 * var(--gutter));
      padding: 0.5rem var(--gutter) 1rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    /* Tall enough to read, short enough that a phone fits on screen under the header with its caption. */
    .slot {
      --row-height: min(100svh - 12rem, 157vw);
      --shot-width: calc((var(--row-height) - var(--frame)) * var(--aspect) + var(--frame));
      flex: none;
      scroll-snap-align: center;
    }

    /* A window as tall as a phone in the row would be wider than the screen. */
    .slot.wide {
      --shot-width: min(85vw, 26rem);
    }
  }
</style>
