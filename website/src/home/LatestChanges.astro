---
import { releaseNotes } from "../changelog/release-notes.ts";
import { latestRelease, releaseDate } from "../download/latest-release.ts";
import { RELEASES } from "../site/links.ts";
import Highlights from "./Highlights.astro";

/** The card stays short; the rest is a click away on the release page. */
const MAX_CHANGES = 4;

const published = await latestRelease();
const notes = releaseNotes();
// CHANGELOG.md can already hold notes for a release that is still a draft, so the card follows the release the
// download buttons offer, and the newest notes only when GitHub couldn't be asked.
const latest = (published && notes.find((release) => `v${release.version}` === published.tag)) ?? notes[0]!;
const date = releaseDate(published?.tag === `v${latest.version}` ? published.publishedAt : latest.date);

let room = MAX_CHANGES;
const shown = latest.sections.flatMap((section) => {
  const changes = section.changes.slice(0, room);
  room -= changes.length;
  return changes.length > 0 ? [{ kind: section.kind, changes }] : [];
});
---

<section class="changes" aria-labelledby="changes-title">
  <div class="heading">
    <p class="kicker">What's new</p>
    <h2 id="changes-title">Katari {latest.version}</h2>
    <p class="date">{date}</p>
  </div>
  <div>
    {
      shown.map((section) => (
        <div class="kind">
          <h3>{section.kind}</h3>
          <Highlights items={section.changes} />
        </div>
      ))
    }
    <a href={`${RELEASES}/tag/v${latest.version}`}>Release notes for {latest.version} →</a>
  </div>
</section>

<style>
  .changes {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 2.5rem;
    max-width: calc(var(--page-width) - 2 * var(--gutter));
    margin: 1rem auto 0;
    padding: 1.75rem 2.25rem;
    border: 1px solid var(--indigo-light);
    border-radius: 1rem;
    background: var(--indigo);
  }

  .kicker {
    margin-bottom: 0.4rem;
  }

  h2 {
    margin: 0;
    font-size: 1.9rem;
  }

  .date {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .kind + .kind {
    margin-top: 0.75rem;
  }

  h3 {
    margin: 0 0 0.1rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .changes :global(li) {
    padding-top: 0.3rem;
    padding-bottom: 0.3rem;
  }

  .changes :global(li::before) {
    top: 0.8rem;
  }

  a {
    display: inline-block;
    margin-top: 0.75rem;
  }

  @media (max-width: 74rem) {
    .changes {
      margin-right: var(--gutter);
      margin-left: var(--gutter);
    }
  }

  @media (max-width: 44rem) {
    .changes {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      padding: 1.5rem 1.25rem;
    }
  }
</style>
