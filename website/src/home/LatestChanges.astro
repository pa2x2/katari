---
import { desktopReleaseNotes, releaseNotes, syncServerReleaseNotes, type ReleaseNotes } from "../changelog/release-notes.ts";
import { desktopRelease } from "../download/desktop-release.ts";
import { latestRelease } from "../download/latest-release.ts";
import { syncServerRelease } from "../download/sync-server-release.ts";
import { RELEASES } from "../site/links.ts";
import ChangesCard from "./ChangesCard.astro";

interface Card {
  /** The tab's id, which the script below also uses to open Linux's on Linux. */
  id: "android" | "linux" | "sync-server";
  tab: string;
  app: string;
  release: ReleaseNotes;
  published: Date;
  page: string;
}

// A changelog can already hold notes for a release that is still a draft, so each card follows the release GitHub
// offers, and the newest notes only when GitHub couldn't be asked.
const android = await latestRelease();
const androidNotes = releaseNotes();
const androidLatest = (android && androidNotes.find((release) => `v${release.version}` === android.tag)) ?? androidNotes[0]!;
const cards: Card[] = [
  {
    id: "android",
    tab: "Android",
    app: "Katari for Android",
    release: androidLatest,
    published: android?.tag === `v${androidLatest.version}` ? android.publishedAt : androidLatest.date,
    page: `${RELEASES}/tag/v${androidLatest.version}`,
  },
];

// The desktop app's and the server's cards wait for their first release, as their downloads do.
const desktop = await desktopRelease();
const desktopLatest = desktop && desktopReleaseNotes().find((release) => release.version === desktop.version);
if (desktop && desktopLatest) {
  cards.push({ id: "linux", tab: "Linux", app: "Katari for Linux", release: desktopLatest, published: desktop.publishedAt, page: desktop.page });
}
const server = await syncServerRelease();
const serverLatest = server && syncServerReleaseNotes().find((release) => release.version === server.version);
if (server && serverLatest) {
  cards.push({
    id: "sync-server",
    tab: "Sync server",
    app: "Katari sync server",
    release: serverLatest,
    published: server.publishedAt,
    page: server.page,
  });
}
const tabbed = cards.length > 1;
---

<section class="changes" aria-label="What's new" data-changes>
  {
    tabbed && (
      <div class="tabs" role="tablist" aria-label="Product">
        {cards.map((card, index) => (
          <button
            type="button"
            role="tab"
            id={`changes-tab-${card.id}`}
            aria-controls={`changes-${card.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-tab={card.id}
          >
            {card.tab} <span class="version">{card.release.version}</span>
          </button>
        ))}
      </div>
    )
  }
  {
    cards.map((card, index) => (
      <div
        id={`changes-${card.id}`}
        role={tabbed ? "tabpanel" : undefined}
        aria-labelledby={tabbed ? `changes-tab-${card.id}` : undefined}
        hidden={index !== 0}
      >
        <ChangesCard app={card.app} release={card.release} published={card.published} page={card.page} />
      </div>
    ))
  }
</section>

<script>
  for (const section of document.querySelectorAll<HTMLElement>("[data-changes]")) {
    const tabs = [...section.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (chosen: HTMLButtonElement, focus = false) => {
      for (const tab of tabs) {
        const selected = tab === chosen;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        section.querySelector<HTMLElement>(`#${tab.getAttribute("aria-controls")}`)!.hidden = !selected;
      }
      if (focus) chosen.focus();
    };
    for (const tab of tabs) {
      tab.addEventListener("click", () => select(tab));
      // Arrow keys move between tabs, as a tablist's do.
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (step === 0) return;
        event.preventDefault();
        select(tabs[(tabs.indexOf(tab) + step + tabs.length) % tabs.length]!, true);
      });
    }
    // Linux visitors see the desktop app's notes first; Android's tab is first for everyone else.
    const linux = tabs.find((tab) => tab.dataset.tab === "linux");
    if (linux && /Linux/.test(navigator.userAgent) && !/Android/.test(navigator.userAgent)) select(linux);
  }
</script>

<style>
  .changes {
    width: calc(min(100%, var(--page-width)) - 2 * var(--gutter));
    margin: 1rem auto 0;
  }

  /* On a phone the tabs scroll sideways rather than wrap. */
  .tabs {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.9rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  [role="tab"] {
    flex: none;
    padding: 0.45rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
  }

  [role="tab"]:hover {
    color: var(--text-strong);
  }

  [role="tab"]:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  [role="tab"][aria-selected="true"] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .version {
    opacity: 0.75;
    font-size: 0.85em;
  }
</style>
