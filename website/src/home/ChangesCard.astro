---
import type { ReleaseNotes } from "../changelog/release-notes.ts";
import { releaseDate } from "../download/release-format.ts";
import { leavesSite } from "../site/links.ts";
import Highlights from "./Highlights.astro";

interface Props {
  /** The app's name as the card's title shows it, such as "Katari for Linux". */
  app: string;
  release: ReleaseNotes;
  /** When GitHub says the release was published; the changelog's date otherwise. */
  published: Date;
  /** The release's page on GitHub, with all its notes. */
  page: string;
  /** Alone on the row: the title beside the notes, as the home page showed its single card. */
  alone?: boolean;
}

/** The card stays short; the rest is a click away on the release page. */
const MAX_CHANGES = 4;

const { app, release, published, page, alone = false } = Astro.props;
let room = MAX_CHANGES;
const shown = release.sections.flatMap((section) => {
  const changes = section.changes.slice(0, room);
  room -= changes.length;
  return changes.length > 0 ? [{ kind: section.kind, changes }] : [];
});
---

<article class:list={["card", { alone }]}>
  <div>
    <p class="kicker">What's new</p>
    <h2>{app} <span class="version">{release.version}</span></h2>
    <p class="date">{releaseDate(published)}</p>
  </div>
  <div>
    {
      shown.map((section) => (
        <div class="kind">
          <h3>{section.kind}</h3>
          <Highlights items={section.changes} />
        </div>
      ))
    }
    <a href={page} {...leavesSite()}>Release notes for {release.version} →</a>
  </div>
</article>

<style>
  .card {
    padding: 1.75rem 2.25rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
  }

  .alone {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 2.5rem;
  }

  .alone .date {
    margin-bottom: 0;
  }

  .kicker {
    margin: 0 0 0.4rem;
  }

  h2 {
    margin: 0;
    font-size: 1.9rem;
  }

  .date {
    margin: 0.3rem 0 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .kind + .kind {
    margin-top: 0.75rem;
  }

  .version {
    white-space: nowrap;
  }

  h3 {
    margin: 0 0 0.1rem;
    color: var(--text-muted);
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .card :global(li) {
    padding-top: 0.3rem;
    padding-bottom: 0.3rem;
  }

  .card :global(li::before) {
    top: 0.8rem;
  }

  a {
    display: inline-block;
    margin-top: 0.75rem;
  }

  @media (max-width: 44rem) {
    .card {
      padding: 1.5rem 1.25rem;
    }

    .alone {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
