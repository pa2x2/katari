---
import PlatformSwitch from "../media/PlatformSwitch.astro";
import type { FullFeature } from "./chapters.ts";
import DocsLinks from "./DocsLinks.astro";
import Highlights from "./Highlights.astro";
import ShotStack from "./ShotStack.astro";

interface Props {
  feature: FullFeature;
  /** Puts the screenshots on the left, so that consecutive features alternate sides. */
  flip: boolean;
}

const { feature, flip } = Astro.props;
---

<section id={feature.id} class:list={["feature", { flip }]}>
  <div class="text">
    <h3>{feature.title}</h3>
    <p>{feature.text}</p>
    <Highlights items={feature.highlights} />
    <DocsLinks paths={feature.docs} />
  </div>
  <div class="shots">
    {
      feature.computerShots ? (
        <div class="platform-shots" data-platform-switch data-shows="Android">
          <PlatformSwitch labels={{ Android: "Phone", Linux: "Computer" }} />
          <div class="sides">
            <div class="side" data-platform="Android">
              <ShotStack shots={feature.shots} arrangement="switch" />
            </div>
            <div class="side" data-platform="Linux">
              <ShotStack shots={feature.computerShots} arrangement="switch" />
            </div>
          </div>
        </div>
      ) : (
        <ShotStack shots={feature.shots} arrangement="switch" />
      )
    }
  </div>
</section>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: 4rem;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 4rem var(--gutter);
  }

  .flip .text {
    order: 2;
  }

  .platform-shots > :global(.platforms) {
    margin: 0 auto 1.5rem;
  }

  /* Both sides take the same cell and only the chosen one shows, so switching moves nothing below. */
  .sides {
    display: grid;
    align-items: center;
  }

  .side {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .platform-shots[data-shows="Android"] .side[data-platform="Linux"],
  .platform-shots[data-shows="Linux"] .side[data-platform="Android"] {
    visibility: hidden;
  }

  h3 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
  }

  p {
    margin: 0 0 1.4rem;
    color: var(--text-muted);
    font-size: 1.15rem;
  }

  /* Beside the text, a narrow column squeezes three overlapping phones below a readable size, so the text goes on top. */
  @media (max-width: 60rem) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      padding: 3rem var(--gutter);
    }

    .text {
      max-width: 40rem;
    }

    .flip .text {
      order: 0;
    }
  }
</style>
