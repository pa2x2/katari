---
import type { FullFeature } from "./chapters.ts";
import DocsLinks from "./DocsLinks.astro";
import Highlights from "./Highlights.astro";
import ShotStack from "./ShotStack.astro";

interface Props {
  feature: FullFeature;
  /** Puts the screenshots on the left, so that consecutive features alternate sides. */
  flip: boolean;
}

const { feature, flip } = Astro.props;
---

<section id={feature.id} class:list={["feature", { flip }]}>
  <div class="text">
    <h3>{feature.title}</h3>
    <p>{feature.text}</p>
    <Highlights items={feature.highlights} />
    <DocsLinks paths={feature.docs} />
  </div>
  <div class="shots">
    {
      feature.computerShots ? (
        <div data-platform-shots>
          <div class="platforms" role="group" aria-label="Device">
            <button type="button" data-shows="phone" aria-pressed="true">
              Phone
            </button>
            <button type="button" data-shows="computer" aria-pressed="false">
              Computer
            </button>
          </div>
          <div data-platform="phone">
            <ShotStack shots={feature.shots} arrangement="switch" />
          </div>
          <div data-platform="computer" hidden>
            <ShotStack shots={feature.computerShots} arrangement="switch" />
          </div>
        </div>
      ) : (
        <ShotStack shots={feature.shots} arrangement="switch" />
      )
    }
  </div>
</section>

<script>
  import { visitorPlatform } from "../site/visitor-platform.ts";

  for (const shots of document.querySelectorAll<HTMLElement>("[data-platform-shots]")) {
    const buttons = [...shots.querySelectorAll<HTMLButtonElement>("[data-shows]")];
    const show = (platform: string) => {
      for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.shows === platform));
      for (const stack of shots.querySelectorAll<HTMLElement>("[data-platform]")) stack.hidden = stack.dataset.platform !== platform;
    };
    for (const button of buttons) button.addEventListener("click", () => show(button.dataset.shows!));
    // A visitor on a Linux computer sees the Linux app first.
    if (visitorPlatform() === "Linux") show("computer");
  }
</script>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: 4rem;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 4rem var(--gutter);
  }

  .flip .text {
    order: 2;
  }

  .platforms {
    display: flex;
    gap: 0.15rem;
    width: fit-content;
    margin: 0 auto 1.5rem;
    padding: 0.2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .platforms button {
    padding: 0.35rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }

  .platforms button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .platforms button[aria-pressed="true"] {
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
    color: var(--text-strong);
  }

  h3 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
  }

  p {
    margin: 0 0 1.4rem;
    color: var(--text-muted);
    font-size: 1.15rem;
  }

  /* Beside the text, a narrow column squeezes three overlapping phones below a readable size, so the text goes on top. */
  @media (max-width: 60rem) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      padding: 3rem var(--gutter);
    }

    .text {
      max-width: 40rem;
    }

    .flip .text {
      order: 0;
    }
  }
</style>
