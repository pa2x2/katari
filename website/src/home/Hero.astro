---
import bookPaper from "../captures/book-paper.png";
import player from "../captures/player.png";
import translationAfter from "../captures/translation-after.png";
import { offeredPlatforms } from "../download/desktop-release.ts";
import Callout from "../guide/Callout.astro";
import { plannedCapture } from "../media/planned-captures.ts";
import Shot from "../media/Shot.astro";
import { sitePath } from "../site/links.ts";

const platforms = await offeredPlatforms();
---

<section class="hero">
  <div class="pitch">
    <p class="vertical" lang="ja" aria-hidden="true" data-pagefind-ignore>語り</p>
    <div>
      <p class="kicker">Katari · telling stories</p>
      <h1>Every kind of story.<br />One library.</h1>
      <p class="lead">
        Katari is an app for comics, books, and video. Keep them all in one library, translate comics, and see where
        your reading time goes.
      </p>
      <div class="get" data-download-buttons>
        <a class="button" href={sitePath("download/")}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 4v12m-5-5 5 5 5-5M5 20h14" /></svg>
          Download
        </a>
        <p class="platforms">{platforms.join(" · ")}</p>
      </div>
      <div class="personal">
        <Callout label="Personal project">
          <p>
            Katari is built for my own library and my own reading. I share it as it is, and I can't promise features or fixes
            on request. If it doesn't fit what you need, feel free to fork it.
          </p>
        </Callout>
      </div>
    </div>
  </div>
  <div class="fan">
    <div class="desktop">
      <Shot
        image={plannedCapture("sync-desktop.png")}
        alt="A library holding comics, books, and films in Katari for Linux"
        device="window"
        zoomable={false}
        eager
        sizes="(min-width: 60rem) 36rem, 100vw"
      />
    </div>
    <div class="comic">
      <Shot image={translationAfter} alt="A comic page translated into English" zoomable={false} eager sizes="(min-width: 60rem) 11rem, 31vw" />
    </div>
    <div class="book">
      <Shot image={bookPaper} alt="A book in the paper theme" zoomable={false} eager sizes="(min-width: 60rem) 11rem, 31vw" />
    </div>
    <div class="film">
      <Shot image={player} alt="Sintel playing in the video player" device="phone-landscape" zoomable={false} eager sizes="(min-width: 60rem) 23rem, 60vw" />
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 3rem;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 3rem var(--gutter) 2rem;
  }

  .pitch {
    display: flex;
    gap: 2rem;
  }

  .vertical {
    margin: 0.4rem 0 0;
    color: var(--accent);
    font-family: var(--serif);
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    writing-mode: vertical-rl;
  }

  h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.6rem, 5.5vw, 4.4rem);
    letter-spacing: -0.01em;
  }

  .lead {
    max-width: 34rem;
    margin: 0 0 2rem;
    color: var(--text-muted);
    font-size: 1.2rem;
  }

  /* Where Katari runs sits beside the button, and under it once the row has no room. */
  .get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .get svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .platforms {
    margin: 0;
    color: var(--text-muted);
    font-weight: 600;
  }

  .personal {
    margin-top: 1.5rem;
  }

  .fan {
    position: relative;
    width: min(36rem, 100%);
    aspect-ratio: 36 / 40;
    margin: 0 auto;
  }

  .fan > div {
    position: absolute;
    --shot-width: 100%;
  }

  /* The Linux window stands behind, and the phones in front of it cover its sides and lower edge but leave the middle of
     the library showing. */
  .desktop {
    top: 0;
    left: 0;
    width: 100%;
  }

  /* The phones cover the middle of the window, so a labelled frame standing in for it says what it is above them. */
  .desktop :global(.planned) {
    justify-content: flex-start;
    padding-top: 8%;
  }

  /* Tilting a phone this tall swings its corners out by about 6% of the fan's width, so the tilted ones sit that far in. */
  .comic,
  .book {
    top: 28%;
    z-index: 1;
    width: 31%;
  }

  .comic {
    left: 5%;
    transform: rotate(-7deg);
  }

  .book {
    right: 5%;
    transform: rotate(7deg);
  }

  .film {
    bottom: 0;
    left: 18%;
    z-index: 2;
    width: 64%;
  }

  @media (max-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 2rem;
    }
  }

  @media (max-width: 44rem) {
    .vertical {
      display: none;
    }
  }
</style>
