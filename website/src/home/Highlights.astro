---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul>{items.map((item) => <li>{item}</li>)}</ul>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding: 0.45rem 0 0.45rem 1.5rem;
  }

  li::before {
    content: "";
    position: absolute;
    top: 1.05rem;
    left: 0.3rem;
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--text-muted);
  }
</style>
