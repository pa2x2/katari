---
import BeforeAfter from "../media/BeforeAfter.astro";
import Clip from "../media/Clip.astro";
import { isUpright } from "../media/devices.ts";
import Still from "../media/Shot.astro";
import type { Shot } from "./chapters.ts";

interface Props {
  shot: Shot;
}

const { shot } = Astro.props;
---

{
  shot.kind === "still" && (
    <Still
      image={shot.image}
      alt={shot.alt}
      caption={shot.caption}
      device={shot.device}
      sizes={isUpright(shot.device ?? "phone") ? "(min-width: 44rem) 17rem, 75vw" : "(min-width: 44rem) 28rem, 92vw"}
    />
  )
}
{
  shot.kind === "compare" && (
    <BeforeAfter
      before={shot.before}
      after={shot.after}
      beforeLabel={shot.beforeLabel}
      afterLabel={shot.afterLabel}
      alt={shot.alt}
      caption={shot.caption}
    />
  )
}
{shot.kind === "clip" && <Clip src={shot.src} poster={shot.poster} label={shot.label} caption={shot.caption} />}
