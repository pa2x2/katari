---
import { leavesSite, RELEASES, sitePath } from "../site/links.ts";
import { latestRelease, megabytes, releaseDate } from "./latest-release.ts";

interface Props {
  /** Whether to link the answer that compares the two builds; that answer itself leaves the link out. */
  explained?: boolean;
}

const { explained = true } = Astro.props;
const release = await latestRelease();
// An APK downloads without leaving the page; the releases page, linked when the APKs couldn't be looked up, opens aside.
const target = release ? {} : leavesSite();
---

<div class="download" data-download-buttons>
  <div class="buttons">
    <a class="button" href={release?.standard.url ?? `${RELEASES}/latest`} {...target}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 4v12m-5-5 5 5 5-5M5 20h14" /></svg>
      Download Katari
    </a>
    <a class="button quiet" href={release?.foss.url ?? `${RELEASES}/latest`} {...target}>Katari FOSS</a>
  </div>
  <p>
    {release && <>{release.tag} · {releaseDate(release.publishedAt)} · {megabytes(release.standard)} · </>}Android 10 or newer.
    Katari FOSS leaves out Google services.{explained && <>{" "}<a href={sitePath("guide/install/#which-file")}>Which one?</a></>}
  </p>
</div>

<style>
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* When the two wrap onto separate lines, they grow to one width instead of leaving a ragged pair. */
  .buttons .button {
    flex: 1 1 auto;
    justify-content: center;
    max-width: 16rem;
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  p {
    margin: 0.9rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
