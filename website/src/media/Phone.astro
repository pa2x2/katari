---
import type { ImageMetadata } from "astro";
import { getImage, Picture } from "astro:assets";

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  /** Shown sideways, as the player is. */
  landscape?: boolean;
  /** Loaded with the page instead of when scrolled near, for the first screen. */
  eager?: boolean;
  /** Whether a click opens the shot in the viewer (Viewer.astro) at full height. */
  zoomable?: boolean;
  /** The frame's width as the page lays it out, for picking the image size. */
  sizes: string;
}

const { image, alt, caption, landscape = false, eager = false, zoomable = true, sizes } = Astro.props;
const enlarged = zoomable ? await getImage({ src: image, width: landscape ? 1800 : 900, format: "webp" }) : undefined;
---

<figure class:list={["shot", { landscape }]}>
  {
    enlarged ? (
      <button class="frame" type="button" data-zoom={enlarged.src} data-caption={caption ?? alt}>
        <Picture
          src={image}
          alt={alt}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={landscape ? [640, 960, 1280] : [320, 480, 720]}
          sizes={sizes}
          loading={eager ? "eager" : "lazy"}
        />
        <span class="visually-hidden">Enlarge</span>
      </button>
    ) : (
      <div class="frame">
        <Picture
          src={image}
          alt={alt}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={landscape ? [640, 960, 1280] : [320, 480, 720]}
          sizes={sizes}
          loading={eager ? "eager" : "lazy"}
        />
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    /* Keeps the hidden label inside the shot, so a row that scrolls sideways clips it. */
    position: relative;
    margin: 0;
    width: var(--shot-width, 17rem);
  }

  .frame {
    display: block;
    width: 100%;
    padding: 0.45rem;
    border: 0;
    border-radius: 1.6rem;
    background: #05080f;
    box-shadow:
      0 0 0 1px #2a3550,
      0 1.5rem 3rem -1rem #000c;
  }

  .landscape .frame {
    border-radius: 1.4rem;
  }

  button.frame {
    cursor: zoom-in;
    transition: box-shadow 0.2s;
  }

  button.frame:hover,
  button.frame:focus-visible {
    box-shadow:
      0 0 0 2px var(--clay),
      0 1.5rem 3rem -1rem #000c;
  }

  button.frame:focus-visible {
    outline: none;
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.2rem;
  }

  figcaption {
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.4;
    text-align: center;
  }
</style>
