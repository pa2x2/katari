---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { aspectOf } from "./aspect.ts";

interface Props {
  src: string;
  /** Also gives the frame its proportions, so it must match the video's. */
  poster: ImageMetadata;
  label: string;
  caption: string;
}

const { src, poster, label, caption } = Astro.props;
const posterImage = await getImage({ src: poster, width: 540, format: "webp" });
---

<figure class="shot clip" style={`--aspect: ${aspectOf(poster)}`}>
  <div class="frame">
    <video src={src} poster={posterImage.src} aria-label={label} controls muted loop playsinline preload="none"></video>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  // Plays by itself only for visitors who haven't asked for less motion, and only while on screen, so the clip isn't
  // downloaded for someone who never scrolls to it. The controls pause it either way.
  if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const scrolledAway = new WeakSet<HTMLVideoElement>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          video.play().catch(() => {});
        } else if (!video.paused) {
          scrolledAway.add(video);
          video.pause();
        }
      }
    });
    for (const video of document.querySelectorAll<HTMLVideoElement>(".clip video")) {
      observer.observe(video);
      // A pause the visitor chose stays: the clip no longer starts again when it comes back into view.
      video.addEventListener("pause", () => {
        if (scrolledAway.delete(video)) return;
        observer.unobserve(video);
      });
    }
  }
</script>

<style>
  .clip {
    margin: 0;
    width: var(--shot-width, 17rem);
  }

  .frame {
    padding: 0.45rem;
    border-radius: 1.6rem;
    background: var(--device);
    box-shadow:
      0 0 0 1px var(--device-edge),
      0 1.5rem 3rem -1rem #000c;
  }

  video {
    display: block;
    width: 100%;
    aspect-ratio: var(--aspect);
    border-radius: 1.2rem;
  }

  figcaption {
    margin-top: 0.8rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.4;
    text-align: center;
  }
</style>
