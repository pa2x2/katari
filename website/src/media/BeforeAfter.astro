---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel: string;
  afterLabel: string;
  alt: string;
}

const { before, after, beforeLabel, afterLabel, alt } = Astro.props;
// Both layers must be the same size to line up, so each gets one image rather than a responsive set.
const [beforeImage, afterImage] = await Promise.all(
  [before, after].map((src) => getImage({ src, width: 720, format: "webp" })),
);
---

<figure class="compare">
  <div class="stack">
    <img src={afterImage!.src} alt={alt} width="720" height={Math.round((720 * after.height) / after.width)} loading="lazy" />
    <img class="before" src={beforeImage!.src} alt="" width="720" height={Math.round((720 * before.height) / before.width)} loading="lazy" />
    <span class="label left">{beforeLabel}</span>
    <span class="label right">{afterLabel}</span>
  </div>
  <input type="range" min="0" max="100" value="50" aria-label={`Drag between ${beforeLabel} and ${afterLabel}`} />
</figure>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>(".compare")) {
    const slider = figure.querySelector("input")!;
    const show = () => figure.style.setProperty("--split", `${slider.value}%`);
    slider.addEventListener("input", show);
    show();
  }
</script>

<style>
  .compare {
    --split: 50%;
    margin: 0;
    width: 17rem;
    max-width: calc(50vw - 2.25rem);
    padding: 0.45rem;
    border-radius: 1.6rem;
    background: #05080f;
    box-shadow:
      0 0 0 1px #2a3550,
      0 1.5rem 3rem -1rem #000c;
  }

  .stack {
    position: relative;
    overflow: hidden;
    border-radius: 1.2rem;
  }

  .stack img {
    display: block;
    width: 100%;
    height: auto;
  }

  .before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }

  .stack::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 var(--split);
    width: 2px;
    background: var(--clay);
  }

  .label {
    position: absolute;
    top: 0.75rem;
    padding: 0.15rem 0.6rem;
    border-radius: 1rem;
    background: #000a;
    font-size: 0.8rem;
  }

  .left {
    left: 0.75rem;
  }

  .right {
    right: 0.75rem;
  }

  input {
    width: 100%;
    margin: 0.6rem 0 0.2rem;
    accent-color: var(--clay);
  }
</style>
