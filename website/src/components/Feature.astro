---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="feature">
  <div class="text">
    <h2>{title}</h2>
    <slot />
  </div>
  <div class="shots">
    <slot name="shots" />
  </div>
</section>

<style>
  .feature {
    max-width: 72rem;
    margin: 0 auto;
    padding: 5rem 1.5rem 0;
  }

  .text {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }

  h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    margin: 0 0 0.75rem;
  }

  .text :global(p) {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0 0 0.75rem;
  }

  .shots {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: 1.5rem 1rem;
    margin-top: 2.5rem;
  }
</style>
