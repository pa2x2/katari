---
// A page that only sends the visitor to where it moved, keeping the #section the old link pointed at: a meta refresh
// alone would drop it.
import { sitePath } from "../links.ts";

interface Props {
  /** The page's current path on the site. */
  target: string;
}

const target = sitePath(Astro.props.target);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Katari</title>
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <a href={target}>Katari</a>
  </body>
</html>
