---
import SiteSearch from "../search/SiteSearch.astro";
import { leavesSite, REPOSITORY, sitePath } from "./links.ts";
import ThemeSwitch from "./theme/ThemeSwitch.astro";

const links = [
  { label: "Features", href: sitePath("#features") },
  { label: "Docs", href: sitePath("docs/") },
  { label: "Credits", href: sitePath("credits/") },
  { label: "GitHub", href: REPOSITORY, external: true },
];
---

<header class="header">
  <div class="inner">
    <a class="brand" href={sitePath()}>
      <img src={sitePath("katari.svg")} alt="Katari" width="32" height="32" />
      <span class="name" aria-hidden="true">Katari</span>
    </a>
    <nav aria-label="Site">
      <button class="menu" type="button" aria-expanded="false" aria-controls="site-links">
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
      <ul id="site-links">
        {links.map((link) => <li><a href={link.href} {...(link.external ? leavesSite() : {})}>{link.label}</a></li>)}
        <li class="theme-in-menu"><ThemeSwitch labelled /></li>
      </ul>
    </nav>
    <SiteSearch />
    <div class="theme-in-header"><ThemeSwitch /></div>
    <a class="button download" href={sitePath("docs/install/#which-file")}>Download</a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".header")!;
  const menu = header.querySelector<HTMLButtonElement>(".menu")!;
  const isOpen = () => menu.getAttribute("aria-expanded") === "true";
  const setOpen = (open: boolean) => menu.setAttribute("aria-expanded", String(open));
  menu.addEventListener("click", () => setOpen(!isOpen()));
  // A link in the menu may only scroll this page, which would leave the menu open over what it scrolled to.
  header.querySelector("#site-links")!.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a")) setOpen(false);
  });
  document.addEventListener("click", (event) => {
    if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !isOpen()) return;
    setOpen(false);
    menu.focus();
  });

  // While a page's own download buttons are on screen, the header's would only repeat them.
  const visible = new Set<Element>();
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) visible.add(entry.target);
      else visible.delete(entry.target);
    }
    header.classList.toggle("download-visible", visible.size > 0);
    header.classList.add("settled");
  });
  for (const buttons of document.querySelectorAll("[data-download-buttons]")) observer.observe(buttons);
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: var(--page-width);
    height: var(--header-height);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-strong);
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    margin-left: auto;
  }

  ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    color: var(--text-muted);
    text-decoration: none;
  }

  ul a:hover {
    color: var(--text-strong);
  }

  .menu {
    display: none;
    padding: 0.4rem;
    border: 0;
    background: none;
    color: var(--text-strong);
    cursor: pointer;
  }

  .menu svg {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .download {
    padding: 0.45rem 1rem;
  }

  /* A page with its own download buttons usually opens on them, so the header's stays hidden until the script has
     looked rather than showing for a moment and fading away. It only fades in or out once the visitor scrolls. */
  :global(body:has([data-download-buttons])) .header:not(.settled) .download,
  .download-visible .download {
    visibility: hidden;
    opacity: 0;
  }

  .settled .download {
    transition:
      opacity 0.2s,
      visibility 0.2s;
  }

  /* A phone's header row has no room for the switch, so there it sits in the menu, named. */
  .theme-in-menu {
    display: none;
  }

  @media (max-width: 44rem) {
    .menu {
      display: block;
    }

    /* Download, search and the menu button gather at the right, search beside the menu: while the page's own
       download buttons hide the header's, its space stays empty further left instead of stranding the search. */
    .download {
      margin-left: auto;
    }

    .inner :global(.site-search) {
      order: 1;
    }

    nav {
      order: 2;
      margin-left: 0;
    }

    .inner {
      gap: 1rem;
    }

    .theme-in-header {
      display: none;
    }

    .theme-in-menu {
      display: block;
    }

    ul {
      display: none;
      position: absolute;
      top: var(--header-height);
      right: 0;
      left: 0;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem var(--gutter) 1rem;
      border-bottom: 1px solid var(--border);
      background: var(--bg);
    }

    .menu[aria-expanded="true"] + ul {
      display: flex;
    }

    ul a {
      display: block;
      padding: 0.6rem 0;
      font-size: 1.1rem;
    }
  }

  /* Narrower than this, the name, Download, search and the menu button need more than a phone's width, so the logo
     stands for the name. */
  @media (max-width: 24rem) {
    .name {
      display: none;
    }
  }
</style>
