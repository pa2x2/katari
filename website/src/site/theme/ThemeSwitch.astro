---
// Cycles the page between following the system and a fixed light or dark theme. The header shows it as an icon; on
// phones, where the header row has no room, the menu shows it with its name instead.
interface Props {
  labelled?: boolean;
}

const { labelled = false } = Astro.props;
---

<button class:list={["theme-switch", { labelled }]} type="button" data-theme-switch>
  <svg class="system" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path class="fill" d="M12 4a8 8 0 0 0 0 16z" /></svg>
  <svg class="light" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
  <svg class="dark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z" /></svg>
  <span class:list={[{ "visually-hidden": !labelled }]} data-theme-label>Theme: system</span>
</button>

<script>
  type Theme = "system" | "light" | "dark";
  const key = "katari-theme";
  const order: Theme[] = ["system", "light", "dark"];
  const root = document.documentElement;
  const metas = [...document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')];
  for (const meta of metas) meta.dataset.systemColor ??= meta.content;

  const current = (): Theme => (root.dataset.theme as Theme | undefined) ?? "system";

  const show = (theme: Theme) => {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-switch]")) {
      button.dataset.current = theme;
      button.title = `Theme: ${theme}`;
      button.querySelector("[data-theme-label]")!.textContent = `Theme: ${theme}`;
    }
    // The browser's own bar follows the page's colour, which a fixed theme takes away from the system's.
    const fixed = theme === "system" ? undefined : getComputedStyle(root).backgroundColor;
    for (const meta of metas) meta.content = fixed ?? meta.dataset.systemColor!;
  };

  const apply = (theme: Theme) => {
    if (theme === "system") delete root.dataset.theme;
    else root.dataset.theme = theme;
    try {
      if (theme === "system") localStorage.removeItem(key);
      else localStorage.setItem(key, theme);
    } catch {}
    show(theme);
  };

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-switch]")) {
    button.addEventListener("click", () => apply(order[(order.indexOf(current()) + 1) % order.length]!));
  }
  show(current());
</script>

<style>
  .theme-switch {
    display: grid;
    place-items: center;
    padding: 0.4rem;
    border: 0;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
  }

  .theme-switch:hover {
    color: var(--text-strong);
  }

  .labelled {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0;
    font: inherit;
    font-size: 1.1rem;
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fill {
    fill: currentColor;
    stroke: none;
  }

  /* Only the icon for the current choice shows; without the script the button stays on system. */
  svg:not(.system),
  [data-current="light"] svg:not(.light),
  [data-current="dark"] svg:not(.dark) {
    display: none;
  }

  [data-current="light"] .light,
  [data-current="dark"] .dark {
    display: block;
  }
</style>
