---
import { leavesSite, RELEASES, REPOSITORY, sitePath } from "./links.ts";

const columns = [
  {
    title: "Project",
    links: [
      { label: "Source code", href: REPOSITORY, external: true },
      { label: "Releases", href: RELEASES, external: true },
      { label: "Report a problem", href: `${REPOSITORY}/issues`, external: true },
    ],
  },
  {
    title: "Website",
    links: [
      { label: "Docs", href: sitePath("docs/") },
      { label: "Credits", href: sitePath("credits/") },
    ],
  },
];
---

<footer>
  <div class="inner">
    <div class="brand">
      <img class="logo" src={sitePath("katari.svg")} alt="" width="40" height="40" />
      <p>Every kind of story.<br />One library.</p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <h2>{column.title}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href} {...(link.external ? leavesSite() : {})}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="legal">
    <p>
      Katari is an independent fork of <a href="https://github.com/mihonapp/mihon" {...leavesSite()}>Mihon</a> and would not exist without
      the people who build it. It is not an official Mihon project.
    </p>
    <p>
      Katari hosts no content and has no affiliation with the content providers it can reach. The screenshots show openly
      licensed works; see the <a href={sitePath("credits/")}>credits</a>.
    </p>
    <p>
      Katari is a personal project, built for my own use. Requests for features or changes may go unanswered, and forking
      it is always welcome.
    </p>
    <p>Licensed under the <a href={`${REPOSITORY}/blob/main/LICENSE`} {...leavesSite()}>Apache License 2.0</a>.</p>
  </div>
</footer>

<style>
  footer {
    margin-top: 6rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .inner,
  .legal {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 2.5rem var(--gutter) 0;
  }

  .inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
  }

  .brand {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .brand p {
    margin: 0;
    color: var(--text-strong);
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
  }

  h2 {
    margin: 0 0 0.75rem;
    color: var(--text-strong);
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 600;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 0.4rem;
  }

  ul a {
    color: var(--text-muted);
    text-decoration: none;
  }

  ul a:hover {
    color: var(--text-strong);
  }

  .legal {
    padding-bottom: 3rem;
    font-size: 0.95rem;
  }

  @media (max-width: 44rem) {
    .inner {
      grid-template-columns: 1fr 1fr;
    }

    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
