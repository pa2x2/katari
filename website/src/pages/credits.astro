---
import Page from "../site/Page.astro";
import { leavesSite } from "../site/links.ts";
import type { Credit } from "../../../showcase/pipeline/credits.ts";
import credits from "../captures/credits.json";

// Sorted by title by the capture run.
const works: Credit[] = credits;
---

<Page title="Credits · Katari" description="The openly licensed works shown in Katari's screenshots, and who made them.">
  <main data-pagefind-body>
    <h1>Credits</h1>
    <p>
      Every screenshot and clip on this site shows works that are free to share. They are listed here with the license
      they are shared under and the credit their makers ask for.
    </p>
    <ul class="works">
      {
        works.map((work) => (
          <li>
            <strong lang={work.language}>{work.title}</strong> by {work.author}
            <br />
            {work.attribution}.{" "}
            <a href={work.license.url} {...leavesSite()}>{work.license.name}</a>.
            {work.coverCredit && <span> Cover: {work.coverCredit}.</span>}
          </li>
        ))
      }
    </ul>
    <h2>Translation</h2>
    <p>
      On the device, ogkalu's <a href="https://huggingface.co/ogkalu/comic-text-and-bubble-detector" {...leavesSite()}>Comic text and
      bubble detector</a> finds the speech bubbles and kha-white's <a href="https://github.com/kha-white/manga-ocr" {...leavesSite()}>Manga
      OCR</a> reads their Japanese. Both are under the Apache License 2.0.
    </p>
    <p>
      David Ventura's <a href="https://github.com/davidventura/offline-translator" {...leavesSite()}>Offline Translator</a> made the
      translations on the device, with its Japanese to English model.
    </p>
  </main>
</Page>

<style>
  main {
    max-width: 48rem;
    margin: 0 auto;
    padding: 3rem var(--gutter) 0;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
  }

  main > p {
    color: var(--text);
  }

  .works {
    padding: 0;
    list-style: none;
  }

  .works li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }

  .works strong {
    font-weight: 650;
  }

  .works a {
    white-space: nowrap;
  }
</style>
