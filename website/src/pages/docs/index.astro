---
import { docs } from "../../docs/contents.ts";
import { entryPath } from "../../guide/contents.ts";
import Page from "../../site/Page.astro";
import { leavesSite, REPOSITORY, sitePath } from "../../site/links.ts";

// Where most visitors are headed: the start, a fix, or the other manual.
const shortcuts = [
  {
    title: "New to Katari?",
    text: "Install the app, then add your first title.",
    tone: "start",
    links: [
      { label: "Install", href: sitePath("docs/install/") },
      { label: "First steps", href: sitePath("docs/first-steps/") },
    ],
  },
  {
    title: "Something not working?",
    text: "Cloudflare checks, missing extensions, video that won't play.",
    tone: "help",
    links: [
      { label: "Troubleshooting", href: sitePath("docs/troubleshooting/") },
      { label: "Report a problem", href: `${REPOSITORY}/issues`, external: true },
    ],
  },
  {
    title: "Writing an extension?",
    text: "Set up a project, write a source, publish a store.",
    tone: "developers",
    links: [{ label: "Developers →", href: sitePath("developers/") }],
  },
];
---

<Page title="Docs · Katari" description="Step-by-step help with setting up and using Katari." section="docs">
  <main>
    <p class="kicker">Docs</p>
    <h1>Using Katari</h1>
    <p class="lead">
      Step-by-step help with setting up and using Katari, with every button and setting named as the app shows it.
    </p>
    <nav class="shortcuts" aria-label="Shortcuts">
      {
        shortcuts.map((shortcut) => (
          <div class={shortcut.tone}>
            <strong>{shortcut.title}</strong>
            <p>{shortcut.text}</p>
            <p class="links">
              {shortcut.links.map((link, index) => (
                <>
                  {index > 0 && " · "}
                  <a href={link.href} {...(link.external ? leavesSite() : {})}>
                    {link.label}
                  </a>
                </>
              ))}
            </p>
          </div>
        ))
      }
    </nav>
    {
      docs.groups.filter((group) => !group.boxed).map((group) => (
        <section aria-label={group.title}>
          <h2>{group.title}</h2>
          <ul>
            {group.pages.map((page) => (
              <li>
                <a href={sitePath(entryPath(docs, page))}>
                  <span class="icon">
                    <page.icon aria-hidden="true" />
                  </span>
                  <strong>{page.title}</strong>
                  <span class="summary">{page.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Page>

<style>
  main {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 3rem var(--gutter) 0;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
  }

  .lead {
    max-width: 40rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 1.15rem;
  }

  .shortcuts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .shortcuts div {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
  }

  .shortcuts .start {
    border-color: transparent;
    background: var(--warning-bg);
  }

  .shortcuts .developers {
    border-color: transparent;
    background: var(--note-bg);
  }

  .shortcuts strong {
    display: block;
    color: var(--text-strong);
    font-family: var(--serif);
    font-size: 1.3rem;
  }

  .shortcuts p {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .shortcuts .links a {
    font-weight: 600;
    text-decoration: none;
  }

  h2 {
    margin: 2.5rem 0 0.9rem;
    color: var(--text-strong);
    font-family: var(--sans);
    font-size: 1.05rem;
    font-weight: 600;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    column-gap: 1rem;
    height: 100%;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--surface);
    color: var(--text-strong);
    text-decoration: none;
  }

  li a:hover {
    border-color: var(--accent);
  }

  .icon {
    display: grid;
    grid-row: span 2;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.6rem;
    background: var(--border);
    color: var(--accent);
  }

  .icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    fill: currentColor;
  }

  strong {
    margin-bottom: 0.3rem;
    font-family: var(--serif);
    font-size: 1.3rem;
  }

  .summary {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
