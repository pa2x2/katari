---
import GuidePage from "../../guide/GuidePage.astro";
import Path from "../../guide/Path.astro";
import PlatformAnswers from "../../guide/PlatformAnswers.astro";
import Storyboard from "../../guide/Storyboard.astro";
import StoryboardScreen from "../../guide/StoryboardScreen.astro";
import Task from "../../guide/Task.astro";
import { plannedCapture } from "../../media/planned-captures.ts";
import { sitePath } from "../../site/links.ts";

const shots = (screen: string, alt: string) => ({
  Android: { image: plannedCapture(`bring-over-${screen}.png`), alt },
  Linux: { image: plannedCapture(`desktop-bring-over-${screen}.png`), alt },
});
---

<GuidePage
  manual="docs"
  slug="coming-from-another-app"
  lead="Your library, reading progress, categories and settings can come with you from Mihon, Aniyomi, LNReader and the apps built on them. The other app stays as it is."
>
  <Task id="make-backup" title="Make a backup in the other app">
    <ul>
      <li>
        <strong>Mihon</strong>, TachiyomiSY, Komikku, TachiyomiJ2K, Yōkai, Tachiyomi:<br />
        <Path>More › Settings › Data and storage › Create backup</Path>
      </li>
      <li>
        <strong>Aniyomi</strong>, Animetail, Anikku, Animiru:<br />
        <Path>More › Settings › Data and storage › Create backup</Path>
      </li>
      <li><strong>LNReader</strong>:<br /><Path>More › Settings › Backup › Create backup</Path></li>
    </ul>
    <p>Tick everything you want to keep.</p>
  </Task>

  <Task id="bring-over" title="Bring it over">
    <p>
      In setup, pick <strong>Coming from another app</strong>. After setup, select <Path>Settings › Data and storage › Bring over from
      another app</Path>.
    </p>
    <Storyboard>
      <StoryboardScreen title="Choose the backup" shots={shots("choose", "A Mihon backup picked, with the app Katari found")}>
        <ol>
          <li>Select <strong>Choose backup file</strong> and pick the backup.</li>
          <li>Katari names the app that made it. If that's wrong, select <strong>Change</strong>.</li>
          <li>Select <strong>Convert</strong>.</li>
        </ol>
      </StoryboardScreen>
      <StoryboardScreen title="Check what comes over" shots={shots("report", "What comes over from a Mihon backup, kind by kind")}>
        <ol>
          <li><strong>What comes over</strong> lists the backup kind by kind, each with how much of it comes over.</li>
          <li><strong>Save as Katari backup</strong> keeps the converted file, to restore later or on another device.</li>
        </ol>
      </StoryboardScreen>
      <StoryboardScreen title="See what's left behind" shots={shots("left", "App settings opened: what is left behind and why")}>
        <ol>
          <li>Open a kind that isn't all green to see what is left behind, and why.</li>
        </ol>
      </StoryboardScreen>
      <StoryboardScreen title="Restore" shots={shots("restore", "Restore backup, into a new profile named after the other app")}>
        <ol>
          <li>Select <strong>Restore</strong> and choose the profile: the one in use, or a new one named after the other app.</li>
          <li>Choose what to bring back and select <strong>Restore</strong>.</li>
        </ol>
      </StoryboardScreen>
    </Storyboard>
    <p>
      Restoring works as for one of <a href={sitePath("docs/backups-and-storage/#restore")}>Katari's own backups</a>. Picking another
      app's backup in <strong>Restore backup</strong> sends you here.
    </p>
  </Task>

  <Task id="left-behind" title="What stays behind">
    <p>Some things never come over:</p>
    <table>
      <thead>
        <tr><th>From</th> <th>Left behind</th></tr>
      </thead>
      <tbody>
        <tr><td>Every app</td> <td>Tracker sign-ins and links, and settings Katari has no counterpart for. The report names each one</td></tr>
        <tr><td>Aniyomi</td> <td>Custom player buttons and the skip intro length</td></tr>
        <tr><td>LNReader</td> <td>Imported books, saved covers, which load again, and downloaded chapters, which need downloading again</td></tr>
      </tbody>
    </table>
  </Task>

  <Task id="downloads" title="Keep your downloads" platform="Android">
    <p>
      When setup asks for a storage folder, pick the one Mihon used. Katari finds the chapters Mihon downloaded there, and the backups
      too. To switch later, use <Path>Settings › Data and storage › Storage location</Path>. If some downloads don't show up, tap
      <Path>Settings › Advanced › Reindex downloads</Path>.
    </p>
  </Task>

  <Task id="extensions" title="Extensions">
    <PlatformAnswers>
      <p slot="android">
        Extensions installed for every app on the phone stay available. Those the other app installed privately need installing again,
        from <a href={sitePath("docs/extension-stores/")}>an extension store</a>.
      </p>
      <p slot="linux">Install them again in Katari, from <a href={sitePath("docs/extension-stores/")}>an extension store</a>.</p>
    </PlatformAnswers>
    <p>
      The other app's extension stores come over. After the restore the Library offers to install the extensions your titles need, and
      setup's last page does too when you brought the backup over in setup.
      Very old extensions may show under <strong>Not loaded</strong> until you update them.
      <a href={sitePath("docs/extension-compatibility/")}>Extension compatibility</a> lists the versions Katari loads.
    </p>
  </Task>
</GuidePage>
