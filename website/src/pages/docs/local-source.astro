---
import Callout from "../../guide/Callout.astro";
import GuidePage from "../../guide/GuidePage.astro";
import Path from "../../guide/Path.astro";
import Task from "../../guide/Task.astro";
import { sitePath } from "../../site/links.ts";
---

<GuidePage slug="local-source" lead="Read comics stored on your phone alongside everything else in your library.">
  <Callout label="Comics only" tone="warning">
    <p>
      The local source reads comics. Books and video files can't be added to it, and an EPUB placed there is read as a comic: its pictures
      become the pages.
    </p>
  </Callout>

  <Task id="folder" title="Lay out the folder">
    <p>
      Put each series in a folder of its own inside <code>local/</code> in the <a href={sitePath("docs/backups-and-storage/#storage-folder")}>storage
      folder</a>, one folder or archive per chapter:
    </p>
    <pre><code>{`local/
  Pepper&Carrot/
    cover.jpg
    ComicInfo.xml
    Episode 01.cbz
    Episode 02/
      001.png
      002.png`}</code></pre>
    <p>
      Then open <strong>Local source</strong> in <Path>Browse › Sources</Path>, listed under <strong>Other</strong>. Series you changed in
      the last week show under its <strong>Latest</strong> list.
    </p>
  </Task>

  <Task id="formats" title="Files it reads">
    <ul>
      <li>A chapter is a folder of images, or an archive: <code>.zip</code>, <code>.cbz</code>, <code>.rar</code>, <code>.cbr</code>, <code>.7z</code>, <code>.cb7</code>, <code>.tar</code>, <code>.cbt</code>, or <code>.epub</code>.</li>
      <li>Chapters are named after their file or folder, and numbered from that name.</li>
      <li>Files and folders whose names start with a dot are ignored.</li>
    </ul>
  </Task>

  <Task id="cover-and-details" title="Cover and details">
    <ul>
      <li>
        A picture named <code>cover</code>, such as <code>cover.jpg</code> or <code>cover.png</code>, becomes the cover. Without one, Katari
        takes the first chapter's first page and saves it as <code>cover.jpg</code>.
      </li>
      <li>
        A <code>ComicInfo.xml</code> beside the chapters gives the title, author, artists, description, genres and status. If a chapter
        archive holds one, Katari copies it out. Inside a chapter, its own <code>ComicInfo.xml</code> can name and number that chapter.
      </li>
    </ul>
  </Task>
</GuidePage>
