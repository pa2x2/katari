---
import Callout from "../../../guide/Callout.astro";
import GuidePage from "../../../guide/GuidePage.astro";
import Member from "../../../guide/reference/Member.astro";
import Members from "../../../guide/reference/Members.astro";
import Path from "../../../guide/Path.astro";
import Snippet from "../../../guide/Snippet.astro";
import Task from "../../../guide/Task.astro";
import { sitePath } from "../../../site/links.ts";

const settings = `
override fun setupPreferenceScreen(screen: EntryPreferenceScreen) {
    screen.addPreference(
        ListPreference(screen.context).apply {
            key = "mirror"
            title = "Mirror"
            entries = arrayOf("shows.example", "mirror.shows.example")
            entryValues = entries
            setDefaultValue("shows.example")
            summary = "%s"
        },
    )
}

override val baseUrl: String
    get() = "https://" + getSourcePreferences().getString("mirror", "shows.example")
`;

const links = `
override fun getUriType(uri: String): EntryUriType {
    val url = uri.toHttpUrlOrNull() ?: return EntryUriType.Unknown
    if (url.host != "shows.example") return EntryUriType.Unknown
    return when (url.pathSegments.firstOrNull()) {
        "show" -> EntryUriType.Entry
        "watch" -> EntryUriType.Chapter
        else -> EntryUriType.Unknown
    }
}

override suspend fun getEntry(uri: String): SEntry? {
    val showUrl = when (getUriType(uri)) {
        EntryUriType.Entry -> uri
        EntryUriType.Chapter -> fetch(uri).selectFirst(".breadcrumb a.show")?.absUrl("href") ?: return null
        EntryUriType.Unknown -> return null
    }
    val entry = SEntry.create().apply {
        setUrlWithoutDomain(showUrl)
        title = ""
        type = EntryType.ANIME
    }
    return refresh(entry, emptyList(), fetchDetails = true, fetchChapters = false).entry
}

override suspend fun getChapter(uri: String): SEntryChapter? =
    SEntryChapter.create().apply {
        url = getUrlWithoutDomain(uri)
        name = ""
    }
`;
---

<GuidePage
  slug="extensions/capabilities"
  lead="A source adds an interface for each thing its site can do beyond the basics, and Katari shows the matching feature only for sources that have it."
>
  <Task id="list" title="What each one adds">
    <Members>
      <Member signature="interface ConfigurableSource : UnifiedSource">
        A settings screen for the source, as in <a href="#settings">Settings</a>.
        <Members label="Implement">
          <Member signature="fun setupPreferenceScreen(screen: EntryPreferenceScreen)" />
        </Members>
      </Member>
      <Member signature="interface RelatedEntriesSource : UnifiedSource">
        <strong>Related entries</strong> on a title's page, in the order returned. They can be of any kind, so set each one's
        <code>type</code>.
        <Members label="Implement">
          <Member signature="suspend fun getRelatedEntries(entry: SEntry): List<RelatedEntryGroup>">
            Each <code>RelatedEntryGroup(title, entries)</code> shows as a row of covers under its <code>title</code>, such as
            <strong>Sequels</strong>. If the site doesn't say how titles relate, return one group with a null title.
          </Member>
        </Members>
      </Member>
      <Member signature="interface ResolvableSource : UnifiedSource">
        Addresses on the site open as the title or chapter they point to, as in <a href="#links">Opening links</a>.
        <Members label="Implement">
          <Member signature="fun getUriType(uri: String): EntryUriType" />
          <Member signature="suspend fun getEntry(uri: String): SEntry?" />
          <Member signature="suspend fun getChapter(uri: String): SEntryChapter?" />
        </Members>
      </Member>
      <Member signature="interface MergedEntrySource : UnifiedSource">
        A title made of other titles of the source, such as a show of several seasons. See
        <a href={sitePath("docs/extensions/source/#merged")}>Merged entries</a>.
        <Members label="Implement">
          <Member signature="suspend fun getMergedEntries(entry: SEntry): List<SEntry>" />
        </Members>
      </Member>
      <Member signature="interface DeferredStreamSource : UnifiedSource">
        Video links that take extra requests to find, looked up only for the stream about to play. See
        <a href={sitePath("docs/extensions/video/#deferred")}>Links found later</a>.
        <Members label="Implement">
          <Member signature="suspend fun resolveStream(chapter: SEntryChapter, stream: VideoStream): VideoStream" />
        </Members>
      </Member>
      <Member signature="interface EntryPreviewSource : UnifiedSource">
        Still images of a video title, such as frames from a film, in its <strong>Preview</strong> when the user long-presses it in a list.
        <Members label="Implement">
          <Member signature="suspend fun getEntryPreview(entry: SEntry): List<EntryPreviewImage>">
            Each image is an <code>EntryPreviewImage(index, imageUrl, title = null, url = null)</code>.
          </Member>
        </Members>
      </Member>
      <Member signature="interface ChapterWebViewSource : WebViewSource">
        <strong>WebView</strong> for a single chapter. <code>EntryImageHttpSource</code> already has it.
        <Members label="Implement">
          <Member signature="fun getContentUrl(entry: SEntry): String" />
          <Member signature="fun getChapterUrl(chapter: SEntryChapter): String" />
        </Members>
      </Member>
      <Member signature="interface ResumableEntryImageSource : EntryImageSource">
        Comic page downloads that pick up where they stopped: Katari asks for the rest with a <code>Range</code> header and keeps what it
        has only when the host answers <code>206 Partial Content</code>. A marker; there is nothing to implement.
      </Member>
      <Member signature="interface EntryItemOrientationProvider">
        Wide covers in lists with <code>HORIZONTAL</code>, for sites whose thumbnails are landscape.
        <Members label="Implement">
          <Member signature="val itemOrientation: EntryItemOrientation"><code>VERTICAL</code> unless overridden.</Member>
        </Members>
      </Member>
      <Member signature="interface UnmeteredSource">
        No warning for this source when a library update holds more than 60 of its titles, or comic downloads queue more than 30 chapters
        or 15 from it. For sources that can take the load, such as your own server. A marker; there is nothing to implement.
      </Member>
      <Member signature="interface ChapterNumberRecognitionSource">
        Katari reads chapter numbers from the names of chapters whose <code>chapterNumber</code> is -1. A marker; there is nothing to
        implement.
      </Member>
      <Member signature="interface EmptyChapterListSource">
        An empty chapter list is accepted rather than treated as an error. A marker; there is nothing to implement.
      </Member>
    </Members>
    <p>
      The immersive view, which plays comics and videos one after another, needs none of these: it works with every source. Books don't
      take part, and a source whose <code>supportedEntryTypes</code> has neither <code>MANGA</code> nor <code>ANIME</code> doesn't offer it.
    </p>
  </Task>

  <Task id="settings" title="Settings">
    <p>
      Settings are AndroidX preferences, and Katari keeps their values for each source and each <a href={sitePath("docs/profiles/")}>profile</a>.
      Read them with <code>getSourcePreferences()</code>:
    </p>
    <Snippet lang="kotlin" code={settings} />
    <p>
      Users reach them through <Path>Browse › Extensions</Path>, the extension, then the source's settings button. Keep every key once
      published, or users lose what they chose.
    </p>
    <Callout label="Read settings where you use them" tone="warning">
      <p>
        Each profile has its own source settings, and a library update or download keeps running for its profile after the user
        switches. <code>getSourcePreferences()</code> reads the right profile inside the source's calls and in interceptors of
        <code>network.client</code>. A value read once and kept, in a property, in the <code>headers</code> or in a <code>lazy</code>
        client, belongs to whichever profile was open at the time. Read the setting each time you need it.
      </p>
    </Callout>
  </Task>

  <Task id="links" title="Opening links">
    <p>
      When an address reaches Katari, such as one another app shares with it, Katari asks each <code>ResolvableSource</code> in turn:
    </p>
    <ol>
      <li>
        <code>getUriType(uri)</code> answers quickly, without a request, whether the address belongs to the source:
        <code>EntryUriType.Entry</code> for a title, <code>Chapter</code> for a chapter, or <code>Unknown</code>. The first source that
        doesn't answer <code>Unknown</code> gets the address. An exception from any source stops the lookup with an error.
      </li>
      <li>
        <code>getEntry(uri)</code> returns the title, also for a chapter's address, where it is the title the chapter belongs to. Katari
        stores it as returned, so fill in its <code>title</code>. Null means the address opens nothing.
      </li>
      <li>
        For a chapter, <code>getChapter(uri)</code> returns it. Katari only uses its <code>url</code>, to find the chapter among the
        title's, and refreshes the chapter list once when it isn't there yet.
      </li>
    </ol>
    <Snippet lang="kotlin" code={links} />
    <p>Here <code>refresh</code> fills in the title, along with the rest of the details.</p>
  </Task>
</GuidePage>
