---
import Callout from "../../../guide/Callout.astro";
import GuidePage from "../../../guide/GuidePage.astro";
import Member from "../../../guide/reference/Member.astro";
import Members from "../../../guide/reference/Members.astro";
import Snippet from "../../../guide/Snippet.astro";
import Task from "../../../guide/Task.astro";
import { sitePath } from "../../../site/links.ts";

const pages = `
override suspend fun getMedia(chapter: SEntryChapter, selection: PlaybackSelection): EntryMedia {
    val pages = fetch(baseUrl + chapter.url).select(".reader img").mapIndexed { index, image ->
        EntryImagePage(index, imageUrl = image.absUrl("src"))
    }
    return EntryMedia.ImagePages(pages)
}
`;

const lazyPages = `
override suspend fun getMedia(chapter: SEntryChapter, selection: PlaybackSelection): EntryMedia {
    val count = fetch(baseUrl + chapter.url).select(".page-select option").size
    val pages = (0 until count).map { index ->
        EntryImagePage(index, url = "$baseUrl\${chapter.url}/\${index + 1}")
    }
    return EntryMedia.ImagePages(pages)
}

override suspend fun getImageUrl(page: EntryImagePage): String =
    fetch(page.url).selectFirst("#page img")!!.absUrl("src")

override fun imageRequest(page: EntryImagePage, imageUrl: String): Request =
    GET(imageUrl, headers.newBuilder().set("Referer", "$baseUrl/").build())
`;

const chapter = `
fun chapterMedia(chapter: SEntryChapter, html: String): EntryMedia.Book {
    val location = BookResourceLocation.InlineText(html, "text/html")
    return EntryMedia.Book(
        descriptor = BookContentDescriptor("text/html", profile = "prose-chapter"),
        catalog = BookResourceCatalog(
            resources = listOf(
                BookSourceResource(
                    id = chapter.url,
                    title = chapter.name,
                    order = 0,
                    mediaType = "text/html",
                    availability = BookResourceAvailability.AVAILABLE,
                    location = location,
                ),
            ),
            coverage = BookCatalogCoverage.COMPLETE,
        ),
        initialResourceId = chapter.url,
        initialResourceLocation = location,
        linkedResources = BookLinkedResources(
            baseUrl = baseUrl + chapter.url,
            headers = mapOf("Referer" to "$baseUrl/"),
        ),
    )
}
`;

const epub = `
fun epubMedia(chapter: SEntryChapter, epubUrl: String): EntryMedia.Book {
    val location = BookResourceLocation.RemoteRequest(epubUrl)
    return EntryMedia.Book(
        descriptor = BookContentDescriptor("application/epub+zip"),
        catalog = BookResourceCatalog(
            resources = listOf(
                BookSourceResource(
                    id = chapter.url,
                    title = chapter.name,
                    order = 0,
                    mediaType = "application/epub+zip",
                    availability = BookResourceAvailability.AVAILABLE,
                    location = location,
                ),
            ),
            coverage = BookCatalogCoverage.COMPLETE,
        ),
        initialResourceId = chapter.url,
        initialResourceLocation = location,
    )
}
`;

const mixed = `
override suspend fun getMedia(chapter: SEntryChapter, selection: PlaybackSelection): EntryMedia =
    when {
        chapter.url.startsWith("/watch/") -> playback(chapter, selection)
        chapter.url.startsWith("/read/") -> pages(chapter)
        else -> error("Unknown chapter address: \${chapter.url}")
    }
`;
---

<GuidePage
  slug="extensions/media"
  lead="When a chapter opens, Katari calls getMedia and hands what comes back to the comic reader, the video player or the book reader."
>
  <Task id="kinds" title="What getMedia returns">
    <p>
      <code>getMedia(chapter, selection)</code> returns one of three kinds of <code>EntryMedia</code>, and the title's
      <code>type</code> decides which Katari expects:
    </p>
    <table class="terms">
      <thead>
        <tr><th>Title type</th> <th>Return</th></tr>
      </thead>
      <tbody>
        <tr><td><code>MANGA</code></td> <td><code>EntryMedia.ImagePages(pages)</code></td></tr>
        <tr><td><code>ANIME</code></td> <td><code>EntryMedia.Playback(descriptor)</code>, as <a href={sitePath("docs/extensions/video/")}>Video</a> describes</td></tr>
        <tr><td><code>BOOK</code></td> <td><code>EntryMedia.Book(descriptor, …)</code></td></tr>
      </tbody>
    </table>
    <p>
      An exception thrown in <code>getMedia</code> shows as an error in the reader or player, with its message.
      <code>selection</code> only matters for video; comics and books ignore it.
    </p>
  </Task>

  <Task id="pages" title="Comic pages">
    <p>A comic chapter is a list of images in reading order. Give each page its image's address when the chapter's page already has it:</p>
    <Snippet lang="kotlin" code={pages} />
    <Members>
      <Member signature="data class EntryImagePage">
        One page of the chapter.
        <Members label="Fields">
          <Member signature="index: Int">The page's position, from 0, unique within the chapter.</Member>
          <Member signature={`url: String = ""`}>
            The address of a page that holds the image, when the image's own address isn't known yet.
          </Member>
          <Member signature="imageUrl: String? = null">The image's full address, or null to find it later.</Member>
        </Members>
      </Member>
    </Members>
    <p>
      Comic sources extend <code>EntryImageHttpSource</code>, since the reader and the downloader load images through it. When each image
      sits on a page of its own, give the page's address as <code>url</code> instead, and find the image in <code>getImageUrl</code>.
      Katari calls it only for pages without an <code>imageUrl</code>, when the reader nears them or the chapter is downloaded. Override <code>imageRequest</code>
      when the image host wants other headers:
    </p>
    <Snippet lang="kotlin" code={lazyPages} />
  </Task>

  <Task id="books" title="Books">
    <p>
      The book reader opens two formats: a novel's chapter as HTML, and a whole book as EPUB. Which one is set by the
      <code>BookContentDescriptor(format, profile, protection = "none")</code>:
    </p>
    <table class="terms">
      <thead>
        <tr><th>Format</th> <th>Descriptor</th></tr>
      </thead>
      <tbody>
        <tr><td>HTML chapter</td> <td>Exactly <code>BookContentDescriptor("text/html", profile = "prose-chapter")</code>.</td></tr>
        <tr><td>EPUB</td> <td><code>BookContentDescriptor("application/epub+zip")</code>; the profile is ignored.</td></tr>
      </tbody>
    </table>
    <p>Anything else, or a protection other than <code>none</code>, shows as a format the reader can't open.</p>
    <Snippet lang="kotlin" code={chapter} />
    <ul>
      <li>
        The HTML is the chapter's text, cleaned of the site's menus and scripts. The reader lays it out in its own style, from the
        elements and styles listed below.
      </li>
      <li>
        For Arabic, Hebrew and other right-to-left text, put <code>dir="rtl"</code> and the <code>lang</code> on the
        <code>&lt;body&gt;</code>, and the reader lays the chapter out right to left.
      </li>
      <li>
        The chapter opens at <code>initialResourceId</code>, or the catalog's only resource when that is null. Its
        <code>InlineText</code> holds the whole chapter, up to the format's 4 MiB. A <code>RemoteRequest</code> to its address works too,
        and lets Katari fetch it.
      </li>
      <li>
        Pictures can stay as the site wrote them: an <code>&lt;img&gt;</code> whose <code>src</code> is a full address, an address
        relative to <code>linkedResources.baseUrl</code> (without one, to the chapter's <code>RemoteRequest</code> address), or a
        <code>data:</code> image. Katari fetches them with <code>linkedResources.headers</code>, reads their type from their bytes and
        keeps them in downloads. A <code>src</code> that is a resource's ID in the catalog names that resource instead.
      </li>
      <li>
        Images can be JPEG, PNG, WebP, GIF, AVIF or SVG, up to 12 MiB each and 1 MiB for SVG, and at most 32,768 pixels on a side and
        64 Mi pixels in all. One that is gone shows its <code>alt</code> text, and the chapter still opens and downloads.
      </li>
      <li>
        Fonts that <code>@font-face</code> rules name by address, <code>data:</code> URI or resource ID are used too: TrueType,
        OpenType, WOFF or WOFF2, up to 4 MiB each.
      </li>
      <li>
        CSS the site applies to every chapter, such as how it draws its notes and boxes, goes in <code>styleSheets</code> once. Katari
        applies it before each chapter's own styles and keeps it with downloads.
      </li>
    </ul>
    <p>A downloadable book is one EPUB file, fetched and opened by Katari:</p>
    <Snippet lang="kotlin" code={epub} />
    <p>
      The resource IDs are where Katari keeps the reader's place, so keep them the same for the same text, and give every chapter an ID
      of its own. The book classes are in
      <code>eu.kanade.tachiyomi.source.entry</code>, and <code>BookContentDescriptor</code>, <code>BookResourceAvailability</code> and
      <code>BookCatalogCoverage</code> in <code>mihon.book.api</code>.
    </p>
    <Callout label="No DRM" tone="warning">
      <p>
        Katari opens EPUB files without copy protection only; a file encrypted with DRM fails to open. Fonts obfuscated as the EPUB
        standard allows are fine.
      </p>
    </Callout>
  </Task>

  <Task id="html" title="What the HTML can hold">
    <p>The reader keeps these elements and drops the tags of all others, keeping their text:</p>
    <p>
      <code>a</code>, <code>abbr</code>, <code>address</code>, <code>article</code>, <code>aside</code>, <code>b</code>,
      <code>blockquote</code>, <code>br</code>, <code>caption</code>, <code>cite</code>, <code>code</code>, <code>dd</code>,
      <code>del</code>, <code>details</code>, <code>dfn</code>, <code>div</code>, <code>dl</code>, <code>dt</code>, <code>em</code>,
      <code>figcaption</code>, <code>figure</code>, <code>footer</code>, <code>h1</code>–<code>h6</code>, <code>header</code>,
      <code>hr</code>, <code>i</code>, <code>img</code>, <code>ins</code>, <code>kbd</code>, <code>li</code>, <code>main</code>,
      <code>mark</code>, <code>nav</code>, <code>ol</code>, <code>p</code>, <code>pre</code>, <code>q</code>, <code>s</code>,
      <code>samp</code>, <code>section</code>, <code>small</code>, <code>span</code>, <code>strong</code>, <code>sub</code>,
      <code>summary</code>, <code>sup</code>, <code>table</code>, <code>tbody</code>, <code>td</code>, <code>tfoot</code>,
      <code>th</code>, <code>thead</code>, <code>tr</code>, <code>u</code>, <code>ul</code>, <code>var</code>.
    </p>
    <ul>
      <li>
        <code>script</code>, <code>iframe</code>, <code>object</code>, <code>embed</code> and <code>canvas</code> are removed with their
        content. <code>audio</code>, <code>video</code> and <code>math</code> become a note that the content isn't supported.
      </li>
      <li>
        Every element keeps <code>id</code>, <code>role</code>, <code>dir</code>, <code>lang</code>, <code>xml:lang</code> and
        <code>epub:type</code>. Besides those, <code>a</code> keeps <code>href</code> and <code>name</code>; <code>img</code> keeps
        <code>src</code>, <code>alt</code>, <code>width</code> and <code>height</code>; <code>ol</code> keeps <code>start</code> and
        <code>type</code>; <code>li</code> keeps <code>value</code>; <code>td</code> and <code>th</code> keep <code>colspan</code>,
        <code>rowspan</code> and <code>scope</code>; <code>details</code> keeps <code>open</code>.
      </li>
      <li>
        Styles come from <code>&lt;style&gt;</code> elements, <code>style</code> attributes and the book's <code>styleSheets</code>, and
        cascade as in a browser: tag, class, ID and attribute selectors with combinators and structural pseudo-classes such as
        <code>:nth-child</code> and <code>:not</code>, specificity, <code>!important</code>, shorthands, every colour syntax, custom
        properties with <code>var()</code>, and <code>@media</code> matched against the reader's page. Rules with <code>:hover</code>
        or a pseudo-element never apply, and <code>@import</code> and <code>@keyframes</code> are skipped.
      </li>
      <li>
        The reader draws text colour and fonts, size, weight, style, small caps, alignment including justified, indents, line height,
        letter spacing, case changes, decoration and text shadows. Around a passage it keeps a box with its background colour or
        gradient, borders, rounded corners, shadows, padding, margins and width. Flex rows and grids of more than one column sit side
        by side, floats let the text wrap around them, and text hidden with <code>display: none</code> is left out.
      </li>
      <li>
        Colours are fitted to the reader's theme, and users can turn a book's styles off with <strong>Publisher styles</strong>.
      </li>
    </ul>
    <p>A chapter that goes past any of these limits fails to open as malformed:</p>
    <table class="terms">
      <thead>
        <tr><th>Limit</th> <th>At most</th></tr>
      </thead>
      <tbody>
        <tr><td>Size of the HTML</td> <td>4 MiB</td></tr>
        <tr><td>Elements</td> <td>100,000</td></tr>
        <tr><td>Text</td> <td>2,000,000 characters</td></tr>
        <tr><td>Nesting depth</td> <td>32 levels, with lists 8 and boxes 16 inside one another</td></tr>
        <tr><td>Blocks, such as paragraphs and headings</td> <td>20,000</td></tr>
        <tr><td>Table columns, and a cell's <code>colspan</code> or <code>rowspan</code></td> <td>24</td></tr>
        <tr><td>CSS rules</td> <td>256 in the chapter and 256 in the book's <code>styleSheets</code>, with 64 declarations each</td></tr>
      </tbody>
    </table>
  </Task>

  <Task id="book-catalog" title="The book's resources">
    <p>
      <code>EntryMedia.Book</code> describes a publication as a catalog of resources, each found at a location. Most sources need only
      the fields in the snippets above.
    </p>
    <Members>
      <Member signature="data class Book : EntryMedia">
        A publication, from <code>getMedia</code>.
        <Members label="Fields">
          <Member signature="descriptor: BookContentDescriptor">The format, as above.</Member>
          <Member signature="catalog: BookResourceCatalog = BookResourceCatalog()">
            The resources Katari knows of.
            <Members label="Fields">
              <Member signature="resources: List<BookSourceResource> = emptyList()">Up to 10,000, with unique IDs.</Member>
              <Member signature="revision: String? = null">The catalog's own revision, apart from the publication's.</Member>
              <Member signature="coverage: BookCatalogCoverage = BookCatalogCoverage.UNKNOWN">
                Whether the list is <code>COMPLETE</code>, <code>PARTIAL</code> or <code>ONGOING</code>, or <code>UNKNOWN</code>.
              </Member>
            </Members>
          </Member>
          <Member signature="initialResourceId: String? = null">The resource the chapter opens at.</Member>
          <Member signature="initialResourceLocation: BookResourceLocation? = null">
            Where to find that resource. A location needs an <code>initialResourceId</code>.
          </Member>
          <Member signature="hierarchy: List<BookResourceHierarchyNode> = emptyList()">
            Groups of resources, such as volumes, for the title's page, each a
            <code>BookResourceHierarchyNode(id, title, resourceIds, children)</code>.
          </Member>
          <Member signature="publicationRevision: String? = null">
            Change it when the text changes, so Katari drops what it saved of the old one.
          </Member>
          <Member signature="publicationKeyOverride: String? = null">Tells apart several publications within one title.</Member>
          <Member signature="linkedResources: BookLinkedResources = BookLinkedResources()">
            How Katari fetches pictures and fonts the documents name by address.
            <Members label="Fields">
              <Member signature="baseUrl: String? = null">
                The <code>http</code> or <code>https</code> address relative ones resolve against, or null for the chapter's
                <code>RemoteRequest</code> address.
              </Member>
              <Member signature="headers: Map<String, String> = emptyMap()">
                Sent with every such request, whatever its host. A redirect to another site keeps only <code>Accept</code>,
                <code>Accept-Language</code>, <code>User-Agent</code> and the <code>Referer</code>'s origin.
              </Member>
            </Members>
          </Member>
          <Member signature="styleSheets: List<String> = emptyList()">
            CSS applied to each HTML chapter before its own styles, up to 262,144 characters in all. Addresses in it resolve like the
            chapter's own. An EPUB keeps only its own styles.
          </Member>
        </Members>
      </Member>
    </Members>
    <p>
      A <code>BookSourceResource</code> has an <code>id</code>, and optionally a <code>title</code>, an <code>order</code> from 0, a
      <code>groupId</code>, a <code>mediaType</code>, which Katari otherwise reads from the bytes, a <code>size</code> in bytes, a
      <code>revision</code>, an <code>availability</code> and a <code>location</code>. Only resources whose availability is <code>AVAILABLE</code> or
      <code>UNKNOWN</code>, the default, can be read; the others, <code>AUTHENTICATION_REQUIRED</code>, <code>PURCHASE_REQUIRED</code>,
      <code>REGION_RESTRICTED</code>, <code>REMOVED</code> and <code>UNSUPPORTED_APP_ACCESS</code>, tell the user why not.
    </p>
    <p>A resource's <code>location</code> is one of these <code>BookResourceLocation</code>s:</p>
    <Members>
      <Member signature="data class InlineText(text: String, mediaType: String? = null) : BookResourceLocation">
        In the text itself, up to 4 Mi characters. An HTML chapter may hold at most 4 MiB as UTF-8.
      </Member>
      <Member signature="class InlineBytes(bytes: ByteArray, mediaType: String? = null) : BookResourceLocation">
        In the bytes themselves, up to 12 MiB, such as a picture the source took out of a chapter it assembled.
      </Member>
      <Member signature="data class RemoteRequest(url: String, headers: Map<String, String> = emptyMap()) : BookResourceLocation">
        At an <code>http</code> or <code>https</code> address, fetched with those headers.
      </Member>
      <Member signature="data class SourceChild(resourceId: String, sourceChildKey: String) : BookResourceLocation">
        From the source, later: Katari calls <code>getMedia</code> with a chapter whose <code>url</code> and <code>name</code> are
        <code>sourceChildKey</code>, and takes the resource with the same ID from what it returns. Use it to list a whole novel's
        chapters without fetching each one.
      </Member>
    </Members>
    <p>
      <code>LocalUri</code> and <code>AppReference</code> are for Katari's own books. Every class checks its fields when created, and an
      invalid one, such as a blank ID, throws <code>IllegalArgumentException</code> from <code>getMedia</code>.
    </p>
  </Task>

  <Task id="mixed" title="Sources with several kinds">
    <p>
      A site with comics and video can stay one source. Set each title's <code>type</code>, and make each chapter's <code>url</code> say
      what it holds, so <code>getMedia</code> knows which to return:
    </p>
    <Snippet lang="kotlin" code={mixed} />
    <p>
      When the address alone can't tell, keep the kind in the chapter's <code>memo</code>, a JSON object Katari stores with it and passes
      back.
    </p>
  </Task>
</GuidePage>
