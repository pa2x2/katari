const declare = `
class SortFilter :
    EntryFilter.Select<String>("Sort by", arrayOf("Popular", "Newest", "A–Z")),
    EntryFilterMetadataProvider {
    override val filterMetadata = EntryFilterMetadata(
        id = "sort",
        role = EntryFilterRole.ORDERING,
        optionIds = listOf("popular", "newest", "title"),
    )
}

class StatusFilter :
    EntryFilter.Select<String>("Status", arrayOf("Any", "Ongoing", "Completed")),
    EntryFilterMetadataProvider {
    override val filterMetadata = EntryFilterMetadata(
        id = "status",
        optionIds = listOf("any", "ongoing", "completed"),
        neutralOptionId = "any",
    )
}

class Genre(name: String, val slug: String) : EntryFilter.TriState(name), EntryFilterMetadataProvider {
    override val filterMetadata = EntryFilterMetadata(id = "genre-$slug")
}

class GenreFilter(genres: List<Genre>) : EntryFilter.Group<Genre>("Genres", genres), EntryFilterMetadataProvider {
    override val filterMetadata = EntryFilterMetadata(id = "genres")
}

fun exampleComicsFilters() = EntryFilterList(
    SortFilter(),
    StatusFilter(),
    GenreFilter(listOf(Genre("Action", "action"), Genre("Romance", "romance"))),
)
`;

const filterList = `
override fun getFilterList() = exampleComicsFilters()
`;

const read = `
private val EntryFilter.Select<*>.selectedOption: String
    get() = (this as EntryFilterMetadataProvider).filterMetadata.optionIds[state]

fun EntryFilterList.applyTo(url: HttpUrl.Builder) {
    forEach { filter ->
        when (filter) {
            is SortFilter -> url.addQueryParameter("sort", filter.selectedOption)
            is StatusFilter -> if (filter.selectedOption != "any") url.addQueryParameter("status", filter.selectedOption)
            is GenreFilter -> filter.state.forEach { genre ->
                when (genre.state) {
                    EntryFilter.TriState.STATE_INCLUDE -> url.addQueryParameter("genre", genre.slug)
                    EntryFilter.TriState.STATE_EXCLUDE -> url.addQueryParameter("exclude", genre.slug)
                }
            }
            else -> Unit
        }
    }
}
`;

const legacy = `
class StatusFilter :
    EntryFilter.Select<String>("Publication", arrayOf("Any", "Ongoing", "Completed", "On hiatus")),
    EntryFilterMetadataProvider {
    override val filterMetadata = EntryFilterMetadata(
        id = "status",
        optionIds = listOf("any", "ongoing", "completed", "hiatus"),
        neutralOptionId = "any",
        legacyNames = setOf("Status"),
        legacyOptionIds = listOf("any", "ongoing", "completed"),
    )
}
`;

const dates = `
class ReleaseDate(name: String, id: String) : EntryDateFilter(
    name = name,
    filterMetadata = EntryFilterMetadata(id = id),
    allowedPrecisions = setOf(EntryDatePrecision.YEAR, EntryDatePrecision.MONTH),
    minimum = EntryPartialDate(1950),
)
`;

const range = `
class ReleasedFilter :
    EntryFilter.Group<ReleaseDate>(
        "Released",
        listOf(ReleaseDate("From", "released-from"), ReleaseDate("To", "released-to")),
    ),
    EntryFilterMetadataProvider,
    EntryFilterValidator {
    override val filterMetadata = EntryFilterMetadata(id = "released")

    override fun validateFilter(values: List<EntryFilter<*>>): List<EntryFilterValidationIssue> {
        val (from, to) = values.map { EntryPartialDate.parse((it as EntryDateFilter).state) }
        if (from == null || to == null || from.earliestDayKey() <= to.latestDayKey()) return emptyList()
        return listOf(
            EntryFilterValidationIssue(setOf("released-from", "released-to"), EntryFilterValidationCode.DATE_RANGE),
        )
    }

    fun applyTo(url: HttpUrl.Builder) {
        val (from, to) = state
        from.dateValue?.let { url.addQueryParameter("from", it.toString()) }
        to.dateValue?.let { url.addQueryParameter("to", it.toString()) }
    }
}
`;

const autocomplete = `
class AuthorFilter : EntryFilter.Autocomplete(
    "Author",
    options = EntryFilterAutocompleteOptions(minimumQueryLength = 2),
) {
    override fun getSuggestionQuery(input: EntryFilterTextInput): String? = input.text.trim()

    override suspend fun getSuggestions(input: EntryFilterTextInput, query: String): List<EntryFilterSuggestion> =
        findAuthors(query).map { EntryFilterSuggestion(id = it.slug, label = it.name) }

    override fun applySuggestion(input: EntryFilterTextInput, suggestion: EntryFilterSuggestion) =
        EntryFilterTextEdit(suggestion.label, selectionStart = suggestion.label.length)
}
`;

const paged = `
@Serializable
data class PickedTag(val label: String, val state: Int)

class TagFilter :
    EntryFilter.PagedGroup<Map<String, PickedTag>>("Tags", emptyMap()),
    EntryFilterMetadataProvider {
    override val filterMetadata = EntryFilterMetadata(id = "tags")

    override suspend fun getPage(request: EntryFilterPageRequest): EntryFilterPage {
        if (request.scope == EntryFilterPageScope.SELECTED) {
            return EntryFilterPage(state.map { (slug, tag) -> EntryFilterPageItem(slug, tag.label) })
        }
        val page = request.continuationToken?.toInt() ?: 1
        val result = findTags(request.query, page, request.requestedSize)
        return EntryFilterPage(
            items = result.tags.map { EntryFilterPageItem(id = it.slug, label = it.name) },
            nextContinuationToken = if (result.hasMore) (page + 1).toString() else null,
        )
    }

    override fun projectItem(item: EntryFilterPageItem, previous: EntryFilter<*>?): EntryFilter<*> {
        val current = state[item.id]?.state ?: EntryFilter.TriState.STATE_IGNORE
        return object : EntryFilter.TriState(item.label, current) {}
    }

    override fun reduceItemUpdate(item: EntryFilterPageItem, updatedFilter: EntryFilter<*>): Map<String, PickedTag> {
        val picked = (updatedFilter as EntryFilter.TriState).state
        return if (picked == EntryFilter.TriState.STATE_IGNORE) {
            state - item.id
        } else {
            state + (item.id to PickedTag(item.label, picked))
        }
    }

    override fun selectedItemCount(state: Map<String, PickedTag>): Int = state.size

    override fun encodeState(state: Map<String, PickedTag>): String = Json.encodeToString(state)

    override fun decodeState(value: String): Map<String, PickedTag>? =
        runCatching { Json.decodeFromString<Map<String, PickedTag>>(value) }.getOrNull()
}
`;
