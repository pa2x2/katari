---
import Chapter from "../home/Chapter.astro";
import { chapters } from "../home/chapters.ts";
import Hero from "../home/Hero.astro";
import LatestVersions from "../home/LatestVersions.astro";
import Viewer from "../media/Viewer.astro";
import Page from "../site/Page.astro";
---

<Page
  section="home"
  title="Katari · Every kind of story. One library."
  description="An app for reading comics and books and watching video in one library, with on-device translation and reading statistics."
>
  <main data-pagefind-body data-pagefind-filter="section:Home">
    <Hero />
    <LatestVersions />
    <div id="features">
      {chapters.map((chapter) => <Chapter chapter={chapter} />)}
    </div>
  </main>
  <Viewer />
</Page>
