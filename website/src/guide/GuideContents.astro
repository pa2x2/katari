---
import { sitePath } from "../site/links.ts";
import { entryPath, type GuideEntry, type Manual } from "./contents.ts";

interface Props {
  manual: Manual;
  current: GuideEntry;
}

const { manual, current } = Astro.props;
---

{/* Beside the page on wide screens; on a phone it folds into one button above the title, so it never pushes the page down.
    It starts open, so that without the script the contents stay reachable everywhere. */}
<details class="contents" open>
  <summary>{manual.name} contents <span>{current.title}</span></summary>
  <nav aria-label={manual.name}>
    <p class="manual">
      {manual.name}
      {manual.badge && <span class="badge">{manual.badge}</span>}
    </p>
    {
      manual.groups.map((group) => (
        <>
          <h2>{group.title}</h2>
          <ul>
            {group.pages.map((page) => (
              <li>
                <a href={sitePath(entryPath(manual, page))} aria-current={page === current ? "page" : undefined}>
                  {page.title}
                </a>
              </li>
            ))}
          </ul>
        </>
      ))
    }
    <ul class="elsewhere">
      {
        manual.links.map((link) => (
          <li>
            <a href={sitePath(link.path)}>{link.label} →</a>
          </li>
        ))
      }
    </ul>
  </nav>
</details>

<script>
  // Open beside the page on wide screens, where its button is hidden; folded on phones; following the window as it resizes.
  const wide = matchMedia("(min-width: 60rem)");
  const contents = document.querySelector<HTMLDetailsElement>("details.contents")!;
  const follow = () => {
    contents.open = wide.matches;
  };
  follow();
  wide.addEventListener("change", follow);
</script>

<style>
  .contents {
    font-size: 0.92rem;
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary span {
    color: var(--text-muted);
  }

  summary span::after {
    content: " ▾";
  }

  .contents[open] summary span::after {
    content: " ▴";
  }

  nav {
    padding: 0.5rem 0.25rem 0;
  }

  .manual {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
    color: var(--text-strong);
    font-weight: 650;
  }

  .badge {
    margin-left: auto;
    padding: 0.05rem 0.5rem;
    border-radius: 1rem;
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
  }

  h2 {
    margin: 1.2rem 0 0.4rem;
    color: var(--text-strong);
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .manual + h2 {
    margin-top: 0;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    padding: 0.28rem 0 0.28rem 0.8rem;
    border-left: 2px solid var(--border);
    color: var(--text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--text-strong);
  }

  .elsewhere {
    margin-top: 1.5rem;
  }

  .elsewhere a {
    padding-left: 0;
    border-left: 0;
    color: var(--accent);
  }

  a[aria-current="page"] {
    border-left-color: var(--accent);
    color: var(--text-strong);
    font-weight: 600;
  }

  @media (min-width: 60rem) {
    summary {
      display: none;
    }

    nav {
      padding: 0;
    }
  }
</style>
