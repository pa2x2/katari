---
import Viewer from "../media/Viewer.astro";
import { leavesSite, REPOSITORY, sitePath } from "../site/links.ts";
import Page from "../site/Page.astro";
import { guideEntry, type ManualId, relatedPages } from "./contents.ts";
import GuideContents from "./GuideContents.astro";
import PageSections from "./PageSections.astro";
import "@fontsource-variable/jetbrains-mono";
import "./guide.css";

interface Props {
  manual: ManualId;
  /** The page's slug in its manual's contents. */
  slug: string;
  /** The sentence under the title, saying what the page is for. */
  lead: string;
}

const { manual: manualId, slug, lead } = Astro.props;
const { manual, entry, group } = guideEntry(manualId, slug);
const related = relatedPages(entry);
// The body renders first so that each Task and Question in it has recorded its section before the sidebar lists them.
Astro.locals.guideSections = [];
const body = await Astro.slots.render("default");
const sections = Astro.locals.guideSections;
---

<Page title={`${entry.title} · ${manual.titleSuffix}`} description={entry.summary} section={manual.id}>
  <div class="guide">
    <aside class="pages">
      <GuideContents manual={manual} current={entry} />
    </aside>
    <aside class="sections">
      <PageSections sections={sections} />
    </aside>
    <main data-pagefind-body data-pagefind-filter={`section:${manual.name}`}>
      <p class="kicker" data-pagefind-ignore>{group.title}</p>
      <h1>{entry.title}</h1>
      <p class="lead">{lead}</p>
      <Fragment set:html={body} />
      <footer class="page-end">
        <p>
          Something wrong or missing?{" "}
          <a href={`${REPOSITORY}/issues`} {...leavesSite()}>Tell us on GitHub</a>.
        </p>
        <nav class="related" aria-labelledby="related-title">
          <h2 id="related-title">Related</h2>
          <ul class="cards">
            {
              related.map((page) => (
                <li>
                  <a href={sitePath(page.path)}>
                    <strong>{page.entry.title}</strong>
                    {page.entry.summary}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </footer>
    </main>
  </div>
  <Viewer />
</Page>

<style>
  /* The guide's pages on the left and the page's own sections on the right, each beside the article rather than
     taken out of its width. Narrower windows fold the sections, then the pages too, into buttons above the article. */
  .guide {
    display: grid;
    grid-template-columns: 14rem minmax(0, 60rem) 14rem;
    grid-template-areas: "pages main sections";
    justify-content: center;
    column-gap: 3rem;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 3rem var(--gutter) 0;
  }

  main {
    grid-area: main;
  }

  .pages {
    grid-area: pages;
  }

  .sections {
    grid-area: sections;
  }

  /* Both stay in view while the article scrolls past them. */
  aside {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    align-self: start;
    max-height: calc(100dvh - var(--header-height) - 3rem);
    overflow-y: auto;
  }

  /* A title longer than any word now still wraps on the smallest phones instead of widening the page. */
  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .lead {
    margin: 0 0 1rem;
    color: var(--text-muted);
    font-size: 1.3rem;
    line-height: 1.5;
  }

  .page-end {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .page-end p {
    margin: 0;
  }

  .related h2 {
    margin: 2rem 0 0.75rem;
    color: var(--text-strong);
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 600;
  }

  .related ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related a {
    display: block;
    height: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .related a:hover {
    border-color: var(--accent);
  }

  .related strong {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--text-strong);
    font-family: var(--serif);
    font-size: 1.15rem;
  }

  @media (width < 88rem) {
    .guide {
      grid-template-columns: 14rem minmax(0, 1fr);
      grid-template-areas:
        "pages sections"
        "pages main";
    }

    .sections {
      position: static;
      max-height: none;
      margin-bottom: 1.75rem;
    }

    .pages {
      grid-row: 1 / span 2;
    }
  }

  /* "Troubleshooting" is wider than the smallest phones' column at the usual size. */
  @media (width < 24rem) {
    h1 {
      font-size: 2rem;
    }
  }

  @media (width < 60rem) {
    .guide {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "pages"
        "sections"
        "main";
      padding-top: 1.5rem;
    }

    aside {
      position: static;
      max-height: none;
    }

    .pages {
      grid-row: auto;
      margin-bottom: 0.75rem;
    }

    .sections {
      margin-bottom: 1.75rem;
    }
  }
</style>
