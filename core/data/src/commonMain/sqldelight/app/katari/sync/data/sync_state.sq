import kotlin.Boolean;

-- Whether this device syncs, and with which server. One row. With enabled = 0 nothing else in the sync tables is
-- read or written, and no change capture runs.
CREATE TABLE sync_state(
    id INTEGER NOT NULL PRIMARY KEY CHECK(id = 0),
    enabled INTEGER AS Boolean NOT NULL DEFAULT 0,
    -- The DeviceId the server gave this device when it registered; NULL before that.
    device_id INTEGER,
    server_url TEXT,
    -- ServerIdentity.instanceId of the server the cursor belongs to.
    server_instance_id TEXT,
    -- The server sequence this device has pulled up to, and the history chain the server reported there.
    cursor INTEGER NOT NULL DEFAULT 0,
    chain TEXT NOT NULL DEFAULT '',
    -- The account the device signed in to, as the server names it.
    account_name TEXT,
    -- Where the connection is (app.katari.sync.client.connection.SyncStage): joining an account, waiting for the
    -- person's first-sync choices, taking the account's records, resyncing in full, or ready.
    stage TEXT NOT NULL DEFAULT 'ready',
    -- The server sequence a first download or full resync runs to, for its progress, as the server last reported it;
    -- 0 when none runs.
    stage_target INTEGER NOT NULL DEFAULT 0,
    -- Why syncing stopped (app.katari.sync.client.connection.SyncStop), NULL while it runs. Kept after the device was
    -- removed, so the app can say so.
    stopped TEXT,
    -- SyncProtocolVersion.CURRENT when a protocol mismatch stopped syncing, so an updated app tries again.
    stopped_protocol INTEGER NOT NULL DEFAULT 0,
    -- Epoch milliseconds of the last sync that reached the server and finished.
    last_synced_at INTEGER,
    -- Epoch milliseconds of the first failure to reach the server since it was last reached; NULL while reachable.
    unreachable_since INTEGER,
    -- The number of the last message from another device handled here (DeviceMessage.number); later ones only are new.
    -- Kept through a full resync: a server restored from a backup still numbers new messages past it.
    messages_handled INTEGER NOT NULL DEFAULT 0,
    -- For a first download that started over on the server's answer, the full resync whose way the records it took
    -- before and doesn't get back are settled once it ends (app.katari.sync.client.resync.FullResync.finishDownload).
    -- NULL in any other stage, and for a download that didn't start over.
    download_restarted_as TEXT,
    -- A restore under way (app.katari.sync.client.restore.RestoreStamping): the last outbox row written before it,
    -- and its backup's creation time in epoch milliseconds. No drain takes the rows after it, which the restore records
    -- as made when the backup was, after a process that stopped meanwhile starts again too. NULL when none is.
    restore_outbox_seq INTEGER,
    restore_backup_created_at INTEGER
);

INSERT OR IGNORE INTO sync_state(id) VALUES (0);

get:
SELECT *
FROM sync_state
WHERE id = 0;

setEnabled:
UPDATE sync_state
SET enabled = :enabled
WHERE id = 0;

setServer:
UPDATE sync_state
SET server_url = :serverUrl, device_id = :deviceId
WHERE id = 0;

-- A device registered with a server: a connection that starts at :stage, with nothing pulled yet.
connect:
UPDATE sync_state
SET server_url = :serverUrl,
    device_id = :deviceId,
    account_name = :accountName,
    server_instance_id = :serverInstanceId,
    cursor = 0,
    chain = '',
    stage = :stage,
    stage_target = 0,
    download_restarted_as = NULL,
    stopped = NULL,
    stopped_protocol = 0,
    last_synced_at = NULL,
    unreachable_since = NULL,
    messages_handled = 0
WHERE id = 0;

setStage:
UPDATE sync_state
SET stage = :stage, stage_target = :stageTarget, download_restarted_as = NULL
WHERE id = 0;

-- A full resync starts over from the server's first record. The server it follows numbers messages anew.
restartPosition:
UPDATE sync_state
SET stage = :stage, stage_target = :stageTarget, cursor = 0, chain = '', server_instance_id = :serverInstanceId,
    download_restarted_as = NULL
WHERE id = 0;

setDownloadRestartedAs:
UPDATE sync_state
SET download_restarted_as = :stage
WHERE id = 0;

setStopped:
UPDATE sync_state
SET stopped = :stopped, stopped_protocol = :stoppedProtocol
WHERE id = 0;

reached:
UPDATE sync_state
SET unreachable_since = NULL, last_synced_at = coalesce(:syncedAt, last_synced_at)
WHERE id = 0;

unreachable:
UPDATE sync_state
SET unreachable_since = coalesce(unreachable_since, :since)
WHERE id = 0;

-- The device no longer belongs to an account; what the person may need to read about it stays.
forget:
UPDATE sync_state
SET enabled = 0,
    device_id = NULL,
    server_instance_id = NULL,
    cursor = 0,
    chain = '',
    stage = 'ready',
    stage_target = 0,
    download_restarted_as = NULL,
    stopped = :stopped,
    stopped_protocol = 0,
    last_synced_at = NULL,
    unreachable_since = NULL,
    messages_handled = 0,
    restore_outbox_seq = NULL,
    restore_backup_created_at = NULL
WHERE id = 0;

-- Clears what a removal left for the person to read.
dismiss:
UPDATE sync_state
SET stopped = NULL, server_url = NULL, account_name = NULL
WHERE id = 0 AND enabled = 0;

-- A pulled page is applied: the device's position on the server it came from. A first download or full resync
-- (:downloadingStages) runs to the account's sequence as each page reports it, since devices that push meanwhile
-- move it on.
setPosition:
UPDATE sync_state
SET server_instance_id = :serverInstanceId, cursor = :cursor, chain = :chain,
    stage_target = CASE WHEN stage IN :downloadingStages THEN :serverSequence ELSE stage_target END
WHERE id = 0;

-- A push was all the server took since the device's position: past it on that server, unless it moved on meanwhile.
passOwnPush:
UPDATE sync_state
SET cursor = :cursor, chain = :chain
WHERE id = 0 AND server_instance_id = :serverInstanceId AND cursor < :cursor;

setMessagesHandled:
UPDATE sync_state
SET messages_handled = :number
WHERE id = 0 AND messages_handled < :number;

-- A restore of a backup created at :backupCreatedAt starts: the rows written from now are its.
startRestore:
UPDATE sync_state
SET restore_outbox_seq = (SELECT coalesce(max(seq), 0) FROM sync_outbox), restore_backup_created_at = :backupCreatedAt
WHERE id = 0;

-- The restore is recorded, or the outbox it held rows of is cleared.
endRestore:
UPDATE sync_state
SET restore_outbox_seq = NULL, restore_backup_created_at = NULL
WHERE id = 0;
