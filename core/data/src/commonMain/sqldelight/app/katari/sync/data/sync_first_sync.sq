-- Whether the device holds the person's data in its database, so its first sync asks how to join it with the account's
-- (D047): a profile of its own, the library, reading history, statistics or categories.
hasOwnRows:
SELECT EXISTS(SELECT 1 FROM profiles WHERE uuid != 'default')
    OR EXISTS(SELECT 1 FROM entries WHERE favorite = 1)
    OR EXISTS(SELECT 1 FROM history)
    OR EXISTS(SELECT 1 FROM activity_sessions)
    OR EXISTS(SELECT 1 FROM categories WHERE _id != 0);

-- How many titles each profile's library holds, so the first-sync screen can tell profiles of one name apart.
librarySizes:
SELECT profile_id, count(*) AS size
FROM entries
WHERE favorite = 1
GROUP BY profile_id;
