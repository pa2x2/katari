-- How sync reads each synced row by the values its capture triggers record as local_ref. Entries name their source
-- by its stable identity, never by the device's local key.

profileRow:
SELECT uuid, name, color_seed, position, is_archived
FROM profiles
WHERE uuid = :uuid;

profiles:
SELECT _id, uuid, name, color_seed
FROM profiles
ORDER BY position, _id;

profileUuid:
SELECT uuid
FROM profiles
WHERE _id = :profileId;

entryRow:
SELECT
    Entry._id,
    Entry.profile_id,
    P.uuid AS profile_uuid,
    S.id_scheme,
    S.external_id,
    Entry.url,
    Entry.type,
    Entry.favorite,
    Entry.date_added,
    Entry.display_name,
    Entry.notes,
    Entry.library_pinned,
    Entry.viewer,
    Entry.chapter_flags,
    Entry.title,
    Entry.author,
    Entry.artist,
    Entry.description,
    Entry.genre,
    Entry.status,
    Entry.thumbnail_url,
    Entry.background_url,
    Entry.memo,
    Entry.update_strategy,
    EXISTS (SELECT 1 FROM entries_placeholder_details WHERE entry_id = Entry._id) AS placeholder_details,
    Name.name AS source_name
FROM entries Entry
JOIN profiles P ON P._id = Entry.profile_id
JOIN source_identities S ON S.local_key = Entry.source
LEFT JOIN sources Name ON Name._id = Entry.source
WHERE Entry._id = :entryId;

chapterRow:
SELECT C.entry_id, C.url, C.read, C.bookmark, C.name, C.chapter_number, C.scanlator, C.date_upload, C.date_fetch,
    C.source_order, C.memo, C.summary, C.preview_url, C.kind, C.date_text, G.group_key, G.title AS group_title,
    G.position AS group_position,
    EXISTS (SELECT 1 FROM chapters_marked_read WHERE chapter_id = C._id) AS marked_read,
    EXISTS (SELECT 1 FROM chapters_placeholder_details WHERE chapter_id = C._id) AS placeholder_details
FROM chapters C
LEFT JOIN chapter_groups G ON G.entry_id = C.entry_id AND G.group_key = C.group_key
WHERE C._id = :chapterId;

progressRow:
SELECT
    entry_id,
    chapter_id,
    content_key,
    resource_key,
    resource_revision,
    locator_kind,
    position,
    extent,
    progression,
    total_progression,
    extensions,
    completed,
    locator_updated_at,
    completion_updated_at
FROM entry_progress_state
WHERE _id = :id;

historyRow:
SELECT entry_id, chapter_id, last_read, time_read
FROM history
WHERE chapter_id = :chapterId;

activitySessionRow:
SELECT session_id, entry_id, started_at, ended_at, duration
FROM activity_sessions
WHERE session_id = :sessionId;

activitySegmentRow:
SELECT session_id, chapter_id, local_date, time_zone_id, started_at, ended_at, duration
FROM activity_segments
WHERE session_id = :sessionId
AND chapter_id IS :chapterId
AND local_date = :localDate
AND time_zone_id = :timeZoneId;

activityCompletionRow:
SELECT event_id, entry_id, chapter_id, session_id, occurred_at, local_date, time_zone_id, cause
FROM activity_completion_events
WHERE event_id = :eventId;

statisticsEpochRow:
SELECT profile_id, started_at, cleared_at
FROM statistics_epochs
WHERE profile_id = :profileId;

categoryRow:
SELECT _id, profile_id, name, sort, flags
FROM categories
WHERE _id = :categoryId
AND _id != 0;

categoryMembershipRow:
SELECT entry_id, category_id
FROM entries_categories
WHERE entry_id = :entryId
AND category_id = :categoryId
LIMIT 1;

categoryUpdateRulesRow:
SELECT
    profile_id,
    category_id,
    auto_update,
    custom_rules,
    skip_completed,
    skip_unseen,
    skip_not_started,
    skip_outside_release_period,
    interval_hours
FROM category_update_rules
WHERE profile_id = :profileId
AND category_id = :categoryId;

entryUpdateModeRow:
SELECT entry_id, mode
FROM entry_update_modes
WHERE entry_id = :entryId;

excludedScanlatorRow:
SELECT entry_id, scanlator
FROM excluded_scanlators
WHERE entry_id = :entryId
AND scanlator = :scanlator
LIMIT 1;

viewerSettingOverrideRow:
SELECT entry_id, provider_id, setting_key, encoded_value
FROM viewer_setting_overrides
WHERE entry_id = :entryId
AND provider_id = :providerId
AND setting_key = :settingKey;

downloadPreferencesRow:
SELECT entry_id, dub_key, stream_key, subtitle_key, quality_mode, server_key, audio_key
FROM download_preferences
WHERE entry_id = :entryId;

translationLanguagesRow:
SELECT entry_id, content_language, target_language, translate_downloads
FROM entry_translation_languages
WHERE entry_id = :entryId;

-- Automatic matches are each device's own; only a pick the user made syncs.
introTimesPickRow:
SELECT entry_id, group_key, anilist_id, mal_id, title, year, first_episode, episodes
FROM intro_times_matches
WHERE entry_id = :entryId
AND group_key = :groupKey
AND picked_by_user = 1;

theIntroDbPickRow:
SELECT entry_id, group_key, tvdb_id, tmdb_id, imdb_id, title, year, season, first_episode
FROM theintrodb_matches
WHERE entry_id = :entryId
AND group_key = :groupKey
AND picked_by_user = 1;

-- Picture framing, zoom and pan depend on the screen, and mpv_hint_shown is this device's own hint; neither syncs.
playbackPreferencesRow:
SELECT
    entry_id,
    dub_key,
    stream_key,
    source_quality_key,
    subtitle_key,
    player_quality_mode,
    player_quality_height,
    subtitle_offset_x,
    subtitle_offset_y,
    subtitle_text_size,
    subtitle_text_color,
    subtitle_background_color,
    subtitle_background_opacity,
    subtitle_text_edge,
    player_engine,
    server_key,
    subtitle_position
FROM playback_preferences
WHERE entry_id = :entryId;

-- The entry's place in a merge, and whether that place is one the merged entry's source gave it: the merged entry's
-- own, or that of a title its source lists. Every device derives those from its own refreshes, so they never sync;
-- a title the person added to such a merge does, as every place in a merge the person made does.
mergeMemberRow:
SELECT M.entry_id, M.target_entry_id, M.position,
    EXISTS (
        SELECT 1
        FROM entries T
        WHERE T._id = M.target_entry_id
        AND T.merged_by_source
        AND (
            M.entry_id = M.target_entry_id
            OR EXISTS (
                SELECT 1
                FROM source_merge_listings L
                WHERE L.profile_id = M.profile_id AND L.root_entry_id = M.target_entry_id AND L.entry_id = M.entry_id
            )
        )
    ) AS given_by_source
FROM merged_entries M
WHERE M.profile_id = :profileId
AND M.entry_id = :entryId;

entryMigrationRow:
SELECT source_entry_id, target_entry_id, intent_fingerprint, chapter_state_only
FROM entry_migration_operations
WHERE operation_id = :operationId
AND mode = 'REPLACE';

entryMigrationChapterPositions:
SELECT source_chapter_url, target_chapter_url
FROM entry_migration_chapter_positions
WHERE operation_id = :operationId
ORDER BY position;

extensionRepositoryRow:
SELECT index_url, name, badge_label, signing_key, contact_website, contact_discord, format, extension_list_url
FROM extension_store
WHERE index_url = :indexUrl;

extensionInstallRow:
SELECT pkg_name, installed, changed_at
FROM extension_installs
WHERE pkg_name = :pkgName;

-- The stable identity of the source this device stores under :localKey, for preferences that name sources.
sourceIdentity:
SELECT id_scheme, external_id
FROM source_identities
WHERE local_key = :localKey;
