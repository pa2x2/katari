import kotlin.Boolean;

-- Every record this device has synced or is about to: its key, the local row that holds it, and the record as this
-- device last pushed or merged it.
CREATE TABLE sync_records(
    record_key TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    -- The JSON array that locates the local row, as in sync_outbox.local_ref; NULL once that row is gone.
    local_ref TEXT,
    kind_version INTEGER NOT NULL,
    -- The payload with its field timestamps, including fields a newer app version added that this one doesn't know.
    payload BLOB NOT NULL,
    deleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    -- The server sequence of the copy this record was last pushed as or merged with; 0 before the server had it.
    based_on INTEGER NOT NULL DEFAULT 0,
    -- Set once the server has had this record, and kept through a full resync, so a record missing from the server
    -- can be told apart as deleted elsewhere (set) or not uploaded yet (unset).
    synced INTEGER AS Boolean NOT NULL DEFAULT 0,
    -- Set while a local change waits to be pushed; a retried push sends the same id.
    change_id TEXT,
    -- The payload of the server copy at based_on, as this device last merged it or had it taken; NULL before the
    -- server had the record. Fields that differ from it in payload were edited on this device since.
    base_payload BLOB,
    -- The group the record travels in ([app.katari.sync.client.record.RecordGroups]), such as the entry it belongs to;
    -- empty for none, NULL for a record stored before groups were kept here.
    record_group TEXT,
    -- Set while the record belongs to a part of the account this device chose not to sync: its change waits here,
    -- unpushed, until the part is synced again.
    held_back INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX idx_sync_records_local ON sync_records(kind, local_ref) WHERE local_ref IS NOT NULL;
-- Indexed by kind alone, each kind's entries stay in rowid order, so a record stored joins the end of its kind's run.
-- Record keys are hashes: indexed by key, every record stored rewrote a page of its own in each such index, which made a
-- first sync write about 20 KB for every record it stored.
-- The changes waiting to be pushed, a kind at a time in the order a push pages through them, which every run reads.
-- Held-back changes are left out, so the count of what waits, which the status reruns after every commit, reads only
-- this index. Read from the table, it outlasted a first sync's commits, and a read open at every commit kept SQLite's
-- checkpoints from finishing, so the WAL grew until the storage was full.
CREATE INDEX idx_sync_records_pending ON sync_records(kind) WHERE change_id IS NOT NULL AND held_back = 0;
CREATE INDEX idx_sync_records_group ON sync_records(record_group, kind, record_key);
-- The records of a kind, such as the open questions the status shows.
CREATE INDEX idx_sync_records_kind ON sync_records(kind);
-- The newest server copy held, which every page pulled and every push checks the server against.
CREATE INDEX idx_sync_records_based_on ON sync_records(based_on);

getByKey:
SELECT record_key, kind, local_ref, kind_version, payload, deleted, based_on, synced, change_id, base_payload,
    record_group, held_back
FROM sync_records
WHERE record_key = :recordKey;

-- Arguments are compared with IS where the column is nullable: against `=`, SQLDelight writes `=` or `IS` by whether
-- the argument is null, and a statement whose text varies is prepared anew for every call, which for a library's
-- records costs more than running it. `local_ref IS NOT NULL` lets SQLite search idx_sync_records_local, which `IS`
-- alone doesn't.
getByLocalRef:
SELECT record_key, kind, local_ref, kind_version, payload, deleted, based_on, synced, change_id, base_payload,
    record_group, held_back
FROM sync_records
WHERE kind = :kind AND local_ref IS :localRef AND local_ref IS NOT NULL;

-- Where the live records of :kind are held here, such as which entries sync.
liveLocalRefs:
SELECT local_ref
FROM sync_records
WHERE kind = :kind AND deleted = 0 AND local_ref IS NOT NULL;

-- The payloads of the live records among :recordKeys.
livePayloads:
SELECT record_key, payload
FROM sync_records
WHERE record_key IN :recordKeys AND deleted = 0;

-- Detaches whatever other record the local row held, so the row holds only the record it was last stored for.
detachLocalRef:
UPDATE sync_records
SET local_ref = NULL
WHERE kind = :kind AND local_ref IS :localRef AND local_ref IS NOT NULL AND record_key != :recordKey;

-- A record holding the row under a key the row no longer has, removed without being marked deleted (D066).
deleteReplaced:
DELETE FROM sync_records
WHERE kind = :kind AND local_ref IS :localRef AND local_ref IS NOT NULL AND record_key != :recordKey;

storeLocalChange:
INSERT INTO sync_records(record_key, kind, local_ref, kind_version, payload, deleted, change_id, record_group)
VALUES (:recordKey, :kind, :localRef, :kindVersion, :payload, :deleted, :changeId, :recordGroup)
ON CONFLICT(record_key) DO UPDATE SET
    local_ref = excluded.local_ref,
    kind_version = excluded.kind_version,
    payload = excluded.payload,
    deleted = excluded.deleted,
    change_id = excluded.change_id,
    record_group = excluded.record_group;

-- The kinds that have changes waiting to be pushed.
pendingKinds:
SELECT DISTINCT kind
FROM sync_records
WHERE change_id IS NOT NULL AND held_back = 0;

-- A record whose newest server copy this app can't read is not pushed: the server would take this app's older
-- format over the newer one. It waits in sync_pending until an update can read it. So does one that failed to apply,
-- whose copy here may lack what the server's holds. Changes of :kind come a page at a time in the order they were
-- stored, after the row :afterRow, so a push reaches every one even when the first are refused. The index is named:
-- SQLite can't tell it from idx_sync_records_kind, over which a page reads every held-back record of the kind first.
pendingOfKindAfter:
SELECT CAST(rowid AS INTEGER) AS row, record_key, kind, local_ref, kind_version, payload, deleted, based_on, synced,
    change_id, base_payload, record_group, held_back
FROM sync_records INDEXED BY idx_sync_records_pending
WHERE change_id IS NOT NULL
AND kind = :kind
AND held_back = 0
AND rowid > :afterRow
AND record_key NOT IN (SELECT record_key FROM sync_pending WHERE reason IN ('unreadable', 'failed'))
ORDER BY rowid
LIMIT :limit;

-- The changes pendingOfKindAfter pages through, counted from idx_sync_records_pending alone, less the few that wait in
-- sync_pending.
pendingCount:
SELECT count(*) - (
    SELECT count(*)
    FROM sync_pending P
    WHERE P.reason IN ('unreadable', 'failed')
    AND EXISTS (
        SELECT 1 FROM sync_records R WHERE R.record_key = P.record_key AND R.change_id IS NOT NULL AND R.held_back = 0
    )
)
FROM sync_records
WHERE change_id IS NOT NULL
AND held_back = 0;

-- The server took the change as :sequence. A change made since keeps its own id and stays pending.
markPushed:
UPDATE sync_records
SET based_on = :sequence,
    synced = 1,
    base_payload = CASE WHEN change_id IS :changeId THEN payload ELSE base_payload END,
    change_id = CASE WHEN change_id IS :changeId THEN NULL ELSE change_id END
WHERE record_key = :recordKey;

-- A server copy merged in: the record as merged, based on that copy, with a change id when the merge holds edits the
-- copy lacks and so must be pushed.
storeMerged:
INSERT INTO sync_records(
    record_key, kind, local_ref, kind_version, payload, deleted, based_on, synced, change_id, base_payload, record_group
)
VALUES (
    :recordKey, :kind, :localRef, :kindVersion, :payload, :deleted, :basedOn, 1, :changeId, :basePayload, :recordGroup
)
ON CONFLICT(record_key) DO UPDATE SET
    local_ref = excluded.local_ref,
    kind_version = excluded.kind_version,
    payload = excluded.payload,
    deleted = excluded.deleted,
    based_on = excluded.based_on,
    synced = 1,
    change_id = excluded.change_id,
    base_payload = excluded.base_payload,
    record_group = excluded.record_group;

-- A page, in key order after :afterKey, of the records other than titles that are in no title's group: those a profile
-- holds besides its titles, such as its settings and categories, the profiles themselves (:profilesGroup), and records
-- stored before groups were kept, until their groups are filled in.
outsideTitlesAfter:
SELECT record_key, kind, deleted, payload
FROM sync_records
WHERE (record_group IS NULL OR record_group = '' OR record_group IS :profilesGroup)
    AND kind != :titleKind AND record_key > :afterKey
ORDER BY record_key
LIMIT :limit;

-- A page of the records of :kind, in the order they were stored, after the row :afterRow.
kindPageAfter:
SELECT CAST(rowid AS INTEGER) AS row, record_key, deleted, payload
FROM sync_records
WHERE kind = :kind AND rowid > :afterRow
ORDER BY rowid
LIMIT :limit;

-- The records in :recordGroup, such as a title with its chapters, progress and history.
inGroup:
SELECT record_key, kind, deleted, payload
FROM sync_records
WHERE record_group IS :recordGroup
ORDER BY record_key;

holdBack:
UPDATE sync_records
SET held_back = 1
WHERE record_key = :recordKey;

-- The changes waiting to be pushed, for holding back those of a part this device stopped syncing.
pushable:
SELECT record_key, kind, deleted, payload
FROM sync_records
WHERE change_id IS NOT NULL AND held_back = 0;

-- The records held back, for letting go of those whose part this device syncs again.
heldBack:
SELECT record_key, kind, deleted, payload, change_id, base_payload, local_ref
FROM sync_records
WHERE held_back = 1;

letGo:
UPDATE sync_records
SET held_back = 0
WHERE record_key = :recordKey;

-- Drops this device's change of a held-back record for the server copy it was based on, which the person chose to
-- keep instead.
takeBase:
UPDATE sync_records
SET payload = base_payload,
    change_id = NULL,
    held_back = 0
WHERE record_key = :recordKey AND base_payload IS NOT NULL;

-- Drops this device's copy of a record it never had from the server, for the copy held for it, which the person chose
-- to keep instead.
forget:
DELETE FROM sync_records
WHERE record_key = :recordKey;

setLocalRef:
UPDATE sync_records
SET local_ref = :localRef
WHERE record_key = :recordKey;

byKind:
SELECT record_key, kind, local_ref, kind_version, payload, deleted, based_on, synced, change_id, base_payload,
    record_group, held_back
FROM sync_records
WHERE kind = :kind
ORDER BY record_key;

-- The live records of :kind in :recordGroup, such as an entry's positions.
liveOfKindInGroup:
SELECT record_key, payload
FROM sync_records
WHERE record_group IS :recordGroup AND kind = :kind AND deleted = 0
ORDER BY record_key;

-- Records stored before groups were kept here, a batch at a time for their groups to be filled in.
ungrouped:
SELECT record_key, kind, deleted, payload
FROM sync_records
WHERE record_group IS NULL
LIMIT :limit;

setGroup:
UPDATE sync_records
SET record_group = :recordGroup
WHERE record_key = :recordKey;

byKinds:
SELECT record_key, kind, local_ref, kind_version, payload, deleted, based_on, synced, change_id, base_payload,
    record_group, held_back
FROM sync_records
WHERE kind IN :kinds
ORDER BY kind, record_key;

-- The server holds no copy of the record, as after retention dropped its deletion marker: the next push makes one.
rebase:
UPDATE sync_records
SET based_on = 0
WHERE record_key = :recordKey;

-- Whether a record of :kind is deleted, such as a profile, whose records' later edits ask about the deletion.
hasDeleted:
SELECT EXISTS(SELECT 1 FROM sync_records WHERE kind = :kind AND deleted = 1);

-- Whether a record of :kind is stored under a version older than :version, to be read again.
hasOutdated:
SELECT EXISTS(SELECT 1 FROM sync_records WHERE kind = :kind AND kind_version < :version);

-- The records of :kind stored under a version older than :version, once they are queued to be read again under it.
raiseVersion:
UPDATE sync_records
SET kind_version = :version
WHERE kind = :kind AND kind_version < :version;

-- A full resync starts: no copy is known to be on the server until the resync's pull brings it again.
forgetBases:
UPDATE sync_records
SET based_on = 0;

-- The newest server sequence this device holds a copy of, by pushing it or pulling it; often past the position, since a
-- device's own pushes come back only with its next pull. A server whose sequence is below it lost what it acknowledged.
newestBase:
SELECT coalesce(max(based_on), 0) FROM sync_records;

-- After a full resync, the records this device had synced that its pull didn't bring, neither merged (based_on) nor
-- held (sync_pending), are pushed again. Deletions only when the pull brought the server's (:withDeletions): one that
-- left them out didn't bring the deletion markers the server still has, and a deletion pushed over one would be
-- refused as stale on every push.
pushUnseen:
UPDATE sync_records
SET change_id = lower(hex(randomblob(16)))
WHERE based_on = 0 AND change_id IS NULL AND synced = 1
AND (deleted = 0 OR :withDeletions)
AND record_key NOT IN (SELECT record_key FROM sync_pending WHERE pulled_since_resync = 1);

-- After a full resync that left deletions out, the live records its pull didn't bring, neither merged nor held, that
-- this device had synced and hasn't changed since: the server dropped their deletion markers, so they were deleted
-- elsewhere.
deletedElsewhere:
SELECT record_key, kind, local_ref, kind_version, payload, deleted, based_on, synced, change_id, base_payload,
    record_group, held_back
FROM sync_records
WHERE based_on = 0 AND change_id IS NULL AND synced = 1 AND deleted = 0
AND record_key NOT IN (SELECT record_key FROM sync_pending WHERE pulled_since_resync = 1)
ORDER BY record_key;

clear:
DELETE FROM sync_records;

-- Whether an earlier connection left records the server had, which a device returning to its account keeps (D066);
-- a device joining afresh has none until its first push.
hasSynced:
SELECT EXISTS(SELECT 1 FROM sync_records WHERE synced = 1);

deleteByLocalRef:
DELETE FROM sync_records
WHERE kind = :kind AND local_ref IS :localRef AND local_ref IS NOT NULL;
