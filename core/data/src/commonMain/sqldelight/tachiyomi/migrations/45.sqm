CREATE TABLE activity_sessions(
    session_id TEXT NOT NULL PRIMARY KEY,
    entry_id INTEGER NOT NULL,
    started_at INTEGER NOT NULL,
    ended_at INTEGER NOT NULL,
    duration INTEGER NOT NULL DEFAULT 0,
    last_sequence INTEGER NOT NULL DEFAULT -1,
    FOREIGN KEY(entry_id) REFERENCES entries(_id) ON DELETE CASCADE,
    CHECK(length(trim(session_id)) > 0),
    CHECK(started_at >= 0),
    CHECK(ended_at >= started_at),
    CHECK(duration >= 0),
    CHECK(last_sequence >= -1)
);

CREATE INDEX idx_activity_sessions_entry_time
ON activity_sessions(entry_id, ended_at);

CREATE TABLE activity_segments(
    session_id TEXT NOT NULL,
    chapter_id INTEGER,
    local_date TEXT NOT NULL,
    time_zone_id TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    ended_at INTEGER NOT NULL,
    duration INTEGER NOT NULL,
    PRIMARY KEY(session_id, chapter_id, local_date, time_zone_id),
    FOREIGN KEY(session_id) REFERENCES activity_sessions(session_id) ON DELETE CASCADE,
    FOREIGN KEY(chapter_id) REFERENCES chapters(_id) ON DELETE SET NULL,
    CHECK(length(local_date) = 10),
    CHECK(length(trim(time_zone_id)) > 0),
    CHECK(started_at >= 0),
    CHECK(ended_at >= started_at),
    CHECK(duration > 0)
);

CREATE INDEX idx_activity_segments_local_date
ON activity_segments(local_date, session_id);

CREATE INDEX idx_activity_segments_chapter
ON activity_segments(chapter_id);

CREATE TABLE activity_completion_events(
    event_id TEXT NOT NULL PRIMARY KEY,
    entry_id INTEGER NOT NULL,
    chapter_id INTEGER,
    session_id TEXT,
    occurred_at INTEGER NOT NULL,
    local_date TEXT NOT NULL,
    time_zone_id TEXT NOT NULL,
    cause TEXT NOT NULL,
    FOREIGN KEY(entry_id) REFERENCES entries(_id) ON DELETE CASCADE,
    FOREIGN KEY(chapter_id) REFERENCES chapters(_id) ON DELETE SET NULL,
    FOREIGN KEY(session_id) REFERENCES activity_sessions(session_id) ON DELETE SET NULL,
    CHECK(length(trim(event_id)) > 0),
    CHECK(occurred_at >= 0),
    CHECK(length(local_date) = 10),
    CHECK(length(trim(time_zone_id)) > 0),
    CHECK(cause IN ('consumption', 'manual'))
);

CREATE INDEX idx_activity_completion_entry_time
ON activity_completion_events(entry_id, occurred_at);

CREATE INDEX idx_activity_completion_local_date
ON activity_completion_events(local_date, entry_id);

CREATE TABLE statistics_epochs(
    profile_id INTEGER NOT NULL PRIMARY KEY,
    started_at INTEGER NOT NULL,
    FOREIGN KEY(profile_id) REFERENCES profiles(_id) ON DELETE CASCADE,
    CHECK(started_at >= 0)
);
