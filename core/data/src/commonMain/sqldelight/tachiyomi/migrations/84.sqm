-- The last message from another device handled here (app/katari/sync/data/sync_state.sq), the messages to the
-- account's other devices waiting to go (app/katari/sync/data/sync_message_outbox.sq), and what the account's device
-- list says of each device beside its name (app/katari/sync/data/sync_devices.sq).
ALTER TABLE sync_state ADD COLUMN messages_handled INTEGER NOT NULL DEFAULT 0;

CREATE TABLE sync_message_outbox(
    seq INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    target_device_id INTEGER,
    kind TEXT NOT NULL,
    kind_version INTEGER NOT NULL,
    payload BLOB NOT NULL,
    replaces TEXT NOT NULL,
    expires_at INTEGER NOT NULL
);

ALTER TABLE sync_devices ADD COLUMN position INTEGER NOT NULL DEFAULT 0;
ALTER TABLE sync_devices ADD COLUMN platform TEXT NOT NULL DEFAULT '';
ALTER TABLE sync_devices ADD COLUMN app_version TEXT NOT NULL DEFAULT '';
ALTER TABLE sync_devices ADD COLUMN last_seen_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE sync_devices ADD COLUMN synced_up_to INTEGER NOT NULL DEFAULT 0;
