---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Shown sideways, as the player is. */
  landscape?: boolean;
  /** The first screen's phone: larger, and loaded with the page instead of when scrolled near. */
  hero?: boolean;
}

const { src, alt, landscape = false, hero = false } = Astro.props;
---

<figure class:list={["phone", { landscape, hero }]}>
  <Picture
    src={src}
    alt={alt}
    formats={["avif"]}
    fallbackFormat="webp"
    widths={landscape ? [640, 960, 1280] : [320, 480, 720]}
    sizes={landscape ? "(min-width: 60rem) 36rem, 92vw" : hero ? "(min-width: 60rem) 21rem, 80vw" : "(min-width: 60rem) 17rem, calc(50vw - 2.25rem)"}
    loading={hero ? "eager" : "lazy"}
  />
</figure>

<style>
  .phone {
    margin: 0;
    width: 17rem;
    /* Two side by side within the page's padding and the gap between them. */
    max-width: calc(50vw - 2.25rem);
    padding: 0.45rem;
    border-radius: 1.6rem;
    background: #05080f;
    box-shadow:
      0 0 0 1px #2a3550,
      0 1.5rem 3rem -1rem #000c;
  }

  .phone.hero {
    width: 21rem;
    max-width: 80vw;
  }

  .phone.landscape {
    width: 36rem;
    max-width: 92vw;
  }

  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.2rem;
  }
</style>
