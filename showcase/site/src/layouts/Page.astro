---
interface Props {
  title: string;
  description: string;
  /** The picture link previews show, as a URL relative to the site. */
  image?: string;
}

const { title, description, image } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <link rel="icon" href={`${base}/katari.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class="bar">
      <a class="brand" href={`${base}/`}>
        <img src={`${base}/katari.svg`} alt="" width="32" height="32" />
        Katari
      </a>
      <nav>
        <a href={`${base}/credits/`}>Credits</a>
        <a href="https://github.com/pa2x2/katari">GitHub</a>
      </nav>
    </header>
    <slot />
    <footer>
      <p>
        Katari is an independent fork of <a href="https://github.com/mihonapp/mihon">Mihon</a> and would not exist without
        the people who build it. It is not an official Mihon project.
      </p>
      <p>
        Katari hosts no content and has no affiliation with the content providers it can reach. The screenshots show
        openly licensed works; see the <a href={`${base}/credits/`}>credits</a>.
      </p>
      <p>Licensed under the <a href="https://github.com/pa2x2/katari/blob/main/LICENSE">Apache License 2.0</a>.</p>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    --night: #0d1424;
    --indigo: #18253f;
    --indigo-light: #253b62;
    --clay: #d8895f;
    --cream: #f4f1e8;
    --muted: #a9b1c4;
    color-scheme: dark;
    background: var(--night);
    color: var(--cream);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    line-height: 1.55;
  }

  body {
    margin: 0;
  }

  a {
    color: var(--clay);
  }

  h1,
  h2 {
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--cream);
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
  }

  .bar nav {
    display: flex;
    gap: 1.25rem;
  }

  .bar nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .bar nav a:hover {
    color: var(--cream);
  }

  footer {
    max-width: 48rem;
    margin: 6rem auto 0;
    padding: 2rem 1.5rem 3rem;
    border-top: 1px solid var(--indigo-light);
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
