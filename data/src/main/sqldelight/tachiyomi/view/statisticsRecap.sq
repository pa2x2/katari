recapSegments:
SELECT
    V.entry_id,
    CH.chapter_number,
    V.local_date,
    V.started_at,
    V.ended_at,
    V.duration,
    V.time_zone_id
FROM statisticsView V
LEFT JOIN chapters CH ON CH._id = V.chapter_id
WHERE V.profile_id = :profileId
AND V.session_id IN (
    SELECT session_id
    FROM activity_sessions
    WHERE duration >= :minimumSessionDurationMillis
)
AND V.local_date >= :startLocalDate
AND V.local_date <= :endLocalDate
ORDER BY V.started_at;

recapEntries:
SELECT
    ENT._id,
    ENT.type,
    ENT.title,
    ENT.genre,
    ENT.thumbnail_url,
    ENT.source,
    ENT.favorite,
    ENT.cover_last_modified
FROM entries ENT
WHERE ENT._id IN (
    SELECT entry_id
    FROM statisticsView
    WHERE profile_id = :profileId
    AND session_id IN (
        SELECT session_id
        FROM activity_sessions
        WHERE duration >= :minimumSessionDurationMillis
    )
    AND local_date >= :startLocalDate
    AND local_date <= :endLocalDate
);

recapCompletions:
SELECT CMP.entry_id, ENT.type, CMP.local_date, count(*) AS count
FROM activity_completion_events CMP
JOIN entries ENT ON ENT._id = CMP.entry_id
WHERE ENT.profile_id = :profileId
AND CMP.cause = 'consumption'
AND CMP.local_date >= :startLocalDate
AND CMP.local_date <= :endLocalDate
GROUP BY CMP.entry_id, CMP.local_date
ORDER BY CMP.local_date;

-- Status 2 is completed and 4 is publishing finished, as sources report them.
recapFinishedEntries:
SELECT ENT._id
FROM entries ENT
WHERE ENT.profile_id = :profileId
AND ENT.status IN (2, 4)
AND EXISTS (SELECT 1 FROM chapters WHERE entry_id = ENT._id)
AND NOT EXISTS (SELECT 1 FROM chapters WHERE entry_id = ENT._id AND read = 0)
AND (
    SELECT max(local_date)
    FROM activity_completion_events
    WHERE entry_id = ENT._id
    AND cause = 'consumption'
) BETWEEN :startLocalDate AND :endLocalDate;

recapFirstActiveDates:
SELECT entry_id, min(local_date) AS first_date
FROM statisticsView
WHERE profile_id = :profileId
AND entry_id IN (
    SELECT entry_id
    FROM statisticsView
    WHERE profile_id = :profileId
    AND local_date >= :startLocalDate
    AND local_date <= :endLocalDate
)
GROUP BY entry_id;

recapProfileFirstActiveDate:
SELECT min(local_date) AS first_date
FROM statisticsView
WHERE profile_id = :profileId;

recapEntryTotals:
SELECT entry_id, CAST(sum(duration) AS INTEGER) AS duration
FROM statisticsView
WHERE profile_id = :profileId
AND session_id IN (
    SELECT session_id
    FROM activity_sessions
    WHERE duration >= :minimumSessionDurationMillis
)
AND local_date >= :startLocalDate
AND local_date <= :endLocalDate
GROUP BY entry_id
ORDER BY duration DESC;

recapHasActivity:
SELECT EXISTS (
    SELECT 1
    FROM statisticsView
    WHERE profile_id = :profileId
    AND session_id IN (
        SELECT session_id
        FROM activity_sessions
        WHERE duration >= :minimumSessionDurationMillis
    )
    AND local_date >= :startLocalDate
    AND local_date <= :endLocalDate
);

recapActiveMonths:
SELECT DISTINCT substr(local_date, 1, 7) AS month
FROM statisticsView
WHERE profile_id = :profileId
AND session_id IN (
    SELECT session_id
    FROM activity_sessions
    WHERE duration >= :minimumSessionDurationMillis
)
ORDER BY month DESC;
