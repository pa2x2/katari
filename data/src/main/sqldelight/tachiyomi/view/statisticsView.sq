CREATE VIEW statisticsView AS
SELECT
    SEG.session_id,
    SEG.chapter_id,
    SEG.local_date,
    SEG.time_zone_id,
    SEG.started_at,
    SEG.ended_at,
    SEG.duration,
    SES.entry_id,
    ENT.profile_id,
    ENT.type,
    ENT.title
FROM activity_segments SEG
JOIN activity_sessions SES ON SES.session_id = SEG.session_id
JOIN entries ENT ON ENT._id = SES.entry_id;

activityTotalsInWindow:
SELECT
    type,
    local_date,
    CAST(sum(duration) AS INTEGER) AS duration
FROM statisticsView
WHERE profile_id = :profileId
AND session_id IN (
    SELECT session_id
    FROM activity_sessions
    WHERE duration >= :minimumSessionDurationMillis
)
AND (:startLocalDate IS NULL OR local_date >= :startLocalDate)
AND (:endLocalDate IS NULL OR local_date <= :endLocalDate)
GROUP BY type, local_date
ORDER BY local_date, type;

detailedLifetimeDurationByType:
SELECT type, CAST(sum(duration) AS INTEGER) AS duration
FROM statisticsView
WHERE profile_id = :profileId
GROUP BY type
ORDER BY type;

earlierActivityEntries:
WITH legacy_entry_totals AS (
    SELECT HIS.entry_id, CAST(sum(HIS.time_read) AS INTEGER) AS duration
    FROM history HIS
    JOIN entries ENT ON ENT._id = HIS.entry_id
    WHERE ENT.profile_id = :profileId
    AND (:type IS NULL OR ENT.type = :type)
    GROUP BY HIS.entry_id
), detailed_entry_totals AS (
    SELECT entry_id, CAST(sum(duration) AS INTEGER) AS duration
    FROM statisticsView
    WHERE profile_id = :profileId
    AND (:type IS NULL OR type = :type)
    GROUP BY entry_id
), earlier_entries AS (
    SELECT
        ENT._id AS entry_id,
        ENT.type,
        ENT.title,
        max(LEG.duration - coalesce(DET.duration, 0), 0) AS duration
    FROM legacy_entry_totals LEG
    JOIN entries ENT ON ENT._id = LEG.entry_id
    LEFT JOIN detailed_entry_totals DET ON DET.entry_id = LEG.entry_id
)
SELECT
    EAR.entry_id,
    EAR.type,
    EAR.title,
    CAST(EAR.duration AS INTEGER) AS duration,
    ENT.thumbnail_url,
    ENT.source,
    ENT.favorite,
    ENT.cover_last_modified
FROM earlier_entries EAR
JOIN entries ENT ON ENT._id = EAR.entry_id
WHERE EAR.duration > 0
ORDER BY EAR.duration DESC, EAR.title COLLATE NOCASE
LIMIT :limit;

sessionSummariesInWindow:
WITH session_totals AS (
    SELECT session_id, type, CAST(sum(duration) AS INTEGER) AS duration
    FROM statisticsView
    WHERE profile_id = :profileId
    AND session_id IN (
        SELECT session_id
        FROM activity_sessions
        WHERE duration >= :minimumSessionDurationMillis
    )
    AND (:startLocalDate IS NULL OR local_date >= :startLocalDate)
    AND (:endLocalDate IS NULL OR local_date <= :endLocalDate)
    GROUP BY session_id, type
)
SELECT
    type,
    count(*) AS session_count,
    CAST(avg(duration) AS INTEGER) AS average_duration,
    CAST(max(duration) AS INTEGER) AS longest_duration
FROM session_totals
GROUP BY type
ORDER BY type;

completionTotalsInWindow:
SELECT
    ENT.type,
    CMP.local_date,
    count(*) AS count
FROM activity_completion_events CMP
JOIN entries ENT ON ENT._id = CMP.entry_id
WHERE ENT.profile_id = :profileId
AND CMP.cause = 'consumption'
AND (:startLocalDate IS NULL OR CMP.local_date >= :startLocalDate)
AND (:endLocalDate IS NULL OR CMP.local_date <= :endLocalDate)
GROUP BY ENT.type, CMP.local_date
ORDER BY CMP.local_date, ENT.type;

topActivityEntriesInWindow:
WITH entry_totals AS (
    SELECT
        entry_id,
        type,
        title,
        CAST(sum(duration) AS INTEGER) AS duration
    FROM statisticsView
    WHERE profile_id = :profileId
    AND session_id IN (
        SELECT session_id
        FROM activity_sessions
        WHERE duration >= :minimumSessionDurationMillis
    )
    AND (:startLocalDate IS NULL OR local_date >= :startLocalDate)
    AND (:endLocalDate IS NULL OR local_date <= :endLocalDate)
    GROUP BY entry_id
), ranked AS (
    SELECT
        entry_id,
        type,
        title,
        duration,
        row_number() OVER (ORDER BY duration DESC, title COLLATE NOCASE) AS overall_rank,
        row_number() OVER (PARTITION BY type ORDER BY duration DESC, title COLLATE NOCASE) AS type_rank
    FROM entry_totals
)
SELECT
    RNK.entry_id,
    RNK.type,
    RNK.title,
    RNK.duration,
    ENT.thumbnail_url,
    ENT.source,
    ENT.favorite,
    ENT.cover_last_modified,
    coalesce(CMP.completion_count, 0) AS completion_count
FROM ranked RNK
JOIN entries ENT ON ENT._id = RNK.entry_id
LEFT JOIN (
    SELECT entry_id, count(*) AS completion_count
    FROM activity_completion_events
    WHERE cause = 'consumption'
    AND (:startLocalDate IS NULL OR local_date >= :startLocalDate)
    AND (:endLocalDate IS NULL OR local_date <= :endLocalDate)
    GROUP BY entry_id
) CMP ON CMP.entry_id = RNK.entry_id
WHERE RNK.overall_rank <= 5 OR RNK.type_rank <= 5
ORDER BY RNK.duration DESC, RNK.title COLLATE NOCASE;

topActivityEntriesPage:
WITH entry_totals AS (
    SELECT
        entry_id,
        type,
        title,
        CAST(sum(duration) AS INTEGER) AS duration
    FROM statisticsView
    WHERE profile_id = :profileId
    AND (:type IS NULL OR type = :type)
    AND session_id IN (
        SELECT session_id
        FROM activity_sessions
        WHERE duration >= :minimumSessionDurationMillis
    )
    AND (:startLocalDate IS NULL OR local_date >= :startLocalDate)
    AND local_date <= :endLocalDate
    GROUP BY entry_id
)
SELECT
    TOT.entry_id,
    TOT.type,
    TOT.title,
    TOT.duration,
    ENT.thumbnail_url,
    ENT.source,
    ENT.favorite,
    ENT.cover_last_modified,
    coalesce(CMP.completion_count, 0) AS completion_count
FROM entry_totals TOT
JOIN entries ENT ON ENT._id = TOT.entry_id
LEFT JOIN (
    SELECT entry_id, count(*) AS completion_count
    FROM activity_completion_events
    WHERE cause = 'consumption'
    AND (:startLocalDate IS NULL OR local_date >= :startLocalDate)
    AND local_date <= :endLocalDate
    GROUP BY entry_id
) CMP ON CMP.entry_id = TOT.entry_id
ORDER BY TOT.duration DESC, TOT.title COLLATE NOCASE
LIMIT :limit OFFSET :offset;

activitySegmentsInWindow:
SELECT type, local_date, started_at, ended_at, duration, time_zone_id
FROM statisticsView
WHERE profile_id = :profileId
AND session_id IN (
    SELECT session_id
    FROM activity_sessions
    WHERE duration >= :minimumSessionDurationMillis
)
AND (:startLocalDate IS NULL OR local_date >= :startLocalDate)
AND (:endLocalDate IS NULL OR local_date <= :endLocalDate)
ORDER BY started_at;
