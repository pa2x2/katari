-- Activity of one title, or of every member of a merged title, for the entry screen.

-- Sessions are recorded against the entry being read, which inside a merge can differ from the entry owning the
-- chapter, so totals are only meaningful over the whole group.
entrySessionTotals:
SELECT
    coalesce(sum(duration), 0) AS duration,
    coalesce(sum(CASE WHEN duration >= :minimumSessionDurationMillis THEN duration ELSE 0 END), 0)
        AS qualifying_duration,
    coalesce(sum(CASE WHEN duration >= :minimumSessionDurationMillis THEN 1 ELSE 0 END), 0)
        AS qualifying_count,
    min(started_at) AS first_started_at
FROM activity_sessions
WHERE entry_id IN :entryIds;

entryLegacyDuration:
SELECT coalesce(sum(H.time_read), 0) AS duration
FROM history H
JOIN chapters C ON C._id = H.chapter_id
WHERE C.entry_id IN :entryIds;

entryLastRead:
SELECT C.name, CAST(H.last_read AS INTEGER) AS last_read
FROM history H
JOIN chapters C ON C._id = H.chapter_id
WHERE C.entry_id IN :entryIds
AND H.last_read > 0
ORDER BY H.last_read DESC
LIMIT 1;

entryFirstRead:
SELECT CAST(min(H.last_read) AS INTEGER) AS first_read
FROM history H
JOIN chapters C ON C._id = H.chapter_id
WHERE C.entry_id IN :entryIds
AND H.last_read > 0;

entryLastCompletion:
SELECT max(occurred_at) AS occurred_at
FROM activity_completion_events
WHERE entry_id IN :entryIds;

entryFirstActivityDate:
SELECT min(SEG.local_date) AS local_date
FROM activity_segments SEG
JOIN activity_sessions SES ON SES.session_id = SEG.session_id
WHERE SES.entry_id IN :entryIds;

entryMonthlyDurations:
SELECT substr(SEG.local_date, 1, 7) AS month, CAST(sum(SEG.duration) AS INTEGER) AS duration
FROM activity_segments SEG
JOIN activity_sessions SES ON SES.session_id = SEG.session_id
WHERE SES.entry_id IN :entryIds
AND SEG.local_date >= :startLocalDate
GROUP BY month
ORDER BY month;

entryChapterDurations:
SELECT C._id, C.read, H.time_read
FROM history H
JOIN chapters C ON C._id = H.chapter_id
WHERE C.entry_id IN :entryIds
AND H.time_read > 0;

-- Median time of a finished chapter across a profile's titles of one type, with the number of chapters it was taken
-- from.
typeChapterDurationMedian:
WITH timed AS (
    SELECT H.time_read AS duration
    FROM history H
    JOIN chapters C ON C._id = H.chapter_id
    JOIN entries ENT ON ENT._id = C.entry_id
    WHERE ENT.profile_id = :profileId
    AND ENT.type = :type
    AND C.read = 1
    AND H.time_read > 0
)
SELECT duration, (SELECT count(*) FROM timed) AS sample_count
FROM timed
ORDER BY duration
LIMIT 1 OFFSET (SELECT (count(*) - 1) / 2 FROM timed);
