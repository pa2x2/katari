import kotlin.Boolean;

CREATE TABLE source_migration_sessions(
    session_id TEXT NOT NULL PRIMARY KEY,
    profile_id INTEGER NOT NULL,
    origin_source_id INTEGER NOT NULL,
    stage TEXT NOT NULL,
    selected_options TEXT NOT NULL,
    cancellation_requested INTEGER AS Boolean NOT NULL DEFAULT 0,
    error_code TEXT,
    error_message TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    completed_at INTEGER,
    FOREIGN KEY(profile_id) REFERENCES profiles(_id) ON DELETE CASCADE,
    CHECK(stage IN (
        'DRAFT',
        'DISCOVERY_QUEUED',
        'DISCOVERING',
        'DISCOVERY_PAUSED',
        'REVIEW_REQUIRED',
        'EXECUTION_QUEUED',
        'EXECUTING',
        'EXECUTION_PAUSED',
        'COMPLETED',
        'CANCELLED',
        'FAILED'
    ))
);

CREATE INDEX source_migration_sessions_profile_stage
ON source_migration_sessions(profile_id, stage, updated_at DESC);

CREATE TABLE source_migration_target_sources(
    session_id TEXT NOT NULL,
    source_id INTEGER NOT NULL,
    position INTEGER NOT NULL,
    PRIMARY KEY(session_id, source_id),
    UNIQUE(session_id, position),
    FOREIGN KEY(session_id) REFERENCES source_migration_sessions(session_id) ON DELETE CASCADE,
    CHECK(position >= 0)
);

CREATE TABLE source_migration_groups(
    session_id TEXT NOT NULL,
    group_id INTEGER NOT NULL,
    position INTEGER NOT NULL,
    visible_entry_id INTEGER NOT NULL,
    visible_title TEXT NOT NULL,
    PRIMARY KEY(session_id, group_id),
    UNIQUE(session_id, position),
    FOREIGN KEY(session_id) REFERENCES source_migration_sessions(session_id) ON DELETE CASCADE,
    CHECK(position >= 0)
);

CREATE TABLE source_migration_group_members(
    session_id TEXT NOT NULL,
    group_id INTEGER NOT NULL,
    entry_id INTEGER NOT NULL,
    position INTEGER NOT NULL,
    source_id INTEGER NOT NULL,
    title TEXT NOT NULL,
    url TEXT NOT NULL,
    thumbnail_url TEXT,
    selected INTEGER AS Boolean NOT NULL,
    PRIMARY KEY(session_id, group_id, entry_id),
    UNIQUE(session_id, group_id, position),
    FOREIGN KEY(session_id, group_id)
        REFERENCES source_migration_groups(session_id, group_id)
        ON DELETE CASCADE,
    CHECK(position >= 0)
);

CREATE TABLE source_migration_items(
    session_id TEXT NOT NULL,
    source_entry_id INTEGER NOT NULL,
    position INTEGER NOT NULL,
    source_id INTEGER NOT NULL,
    source_title TEXT NOT NULL,
    source_url TEXT NOT NULL,
    source_thumbnail_url TEXT,
    state TEXT NOT NULL,
    search_depth TEXT NOT NULL DEFAULT 'STANDARD',
    included INTEGER AS Boolean NOT NULL DEFAULT 0,
    selected_target_entry_id INTEGER,
    target_source_id INTEGER,
    target_title TEXT,
    target_url TEXT,
    target_thumbnail_url TEXT,
    match_kind TEXT,
    operation_key TEXT NOT NULL UNIQUE,
    available_options TEXT NOT NULL DEFAULT '',
    discovery_attempts INTEGER NOT NULL DEFAULT 0,
    execution_attempts INTEGER NOT NULL DEFAULT 0,
    error_code TEXT,
    error_message TEXT,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY(session_id, source_entry_id),
    UNIQUE(session_id, position),
    FOREIGN KEY(session_id) REFERENCES source_migration_sessions(session_id) ON DELETE CASCADE,
    CHECK(position >= 0),
    CHECK(discovery_attempts >= 0),
    CHECK(execution_attempts >= 0),
    CHECK(state IN (
        'DISCOVERY_QUEUED',
        'DISCOVERING',
        'READY',
        'NEEDS_REVIEW',
        'NO_MATCH',
        'DISCOVERY_FAILED',
        'CONFLICT',
        'EXECUTION_QUEUED',
        'EXECUTING',
        'APPLIED',
        'APPLIED_INCOMPLETE',
        'EXECUTION_FAILED',
        'CANCELLED'
    )),
    CHECK(match_kind IS NULL OR match_kind IN ('EXACT', 'SIMILAR', 'MANUAL')),
    CHECK(search_depth IN ('STANDARD', 'BROAD'))
);

CREATE INDEX source_migration_items_session_state
ON source_migration_items(session_id, state, position);

CREATE TABLE source_migration_candidates(
    session_id TEXT NOT NULL,
    source_entry_id INTEGER NOT NULL,
    target_source_id INTEGER NOT NULL,
    target_title TEXT NOT NULL,
    target_url TEXT NOT NULL,
    target_thumbnail_url TEXT,
    rank INTEGER NOT NULL,
    score REAL,
    match_kind TEXT NOT NULL,
    discovered_at INTEGER NOT NULL,
    PRIMARY KEY(session_id, source_entry_id, target_source_id, target_url),
    UNIQUE(session_id, source_entry_id, rank),
    FOREIGN KEY(session_id, source_entry_id)
        REFERENCES source_migration_items(session_id, source_entry_id)
        ON DELETE CASCADE,
    CHECK(rank >= 0),
    CHECK(score IS NULL OR (score >= 0.0 AND score <= 1.0)),
    CHECK(match_kind IN ('EXACT', 'SIMILAR', 'MANUAL'))
);

CREATE TABLE source_migration_discovery_failures(
    session_id TEXT NOT NULL,
    source_entry_id INTEGER NOT NULL,
    target_source_id INTEGER NOT NULL,
    reason TEXT NOT NULL,
    retryable INTEGER AS Boolean NOT NULL,
    detail TEXT,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY(session_id, source_entry_id, target_source_id),
    FOREIGN KEY(session_id, source_entry_id)
        REFERENCES source_migration_items(session_id, source_entry_id)
        ON DELETE CASCADE,
    CHECK(reason IN (
        'SOURCE_MISSING',
        'CATALOGUE_UNSUPPORTED',
        'ENTRY_TYPE_UNSUPPORTED',
        'SEARCH_FAILED'
    ))
);

sessionById:
SELECT *
FROM source_migration_sessions
WHERE session_id = :sessionId;

sessionsByProfile:
SELECT *
FROM source_migration_sessions
WHERE profile_id = :profileId
ORDER BY updated_at DESC;

activeSessionsByProfile:
SELECT *
FROM source_migration_sessions
WHERE profile_id = :profileId
AND stage IN (
    'DISCOVERY_QUEUED',
    'DISCOVERING',
    'DISCOVERY_PAUSED',
    'REVIEW_REQUIRED',
    'EXECUTION_QUEUED',
    'EXECUTING',
    'EXECUTION_PAUSED'
)
ORDER BY updated_at DESC;

targetSourcesBySession:
SELECT source_id
FROM source_migration_target_sources
WHERE session_id = :sessionId
ORDER BY position;

groupsBySession:
SELECT *
FROM source_migration_groups
WHERE session_id = :sessionId
ORDER BY position;

groupMembersBySession:
SELECT *
FROM source_migration_group_members
WHERE session_id = :sessionId
ORDER BY group_id, position;

itemsBySession:
SELECT *
FROM source_migration_items
WHERE session_id = :sessionId
ORDER BY position;

itemById:
SELECT *
FROM source_migration_items
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId
AND state IN ('DISCOVERY_QUEUED', 'DISCOVERING');

candidatesByItem:
SELECT *
FROM source_migration_candidates
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId
ORDER BY rank;

discoveryFailuresByItem:
SELECT *
FROM source_migration_discovery_failures
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId
ORDER BY target_source_id;

insertSession:
INSERT INTO source_migration_sessions(
    session_id,
    profile_id,
    origin_source_id,
    stage,
    selected_options,
    cancellation_requested,
    error_code,
    error_message,
    created_at,
    updated_at,
    completed_at
)
VALUES (
    :sessionId,
    :profileId,
    :originSourceId,
    :stage,
    :selectedOptions,
    0,
    NULL,
    NULL,
    :createdAt,
    :updatedAt,
    NULL
);

insertTargetSource:
INSERT INTO source_migration_target_sources(session_id, source_id, position)
VALUES (:sessionId, :sourceId, :position);

insertGroup:
INSERT INTO source_migration_groups(session_id, group_id, position, visible_entry_id, visible_title)
VALUES (:sessionId, :groupId, :position, :visibleEntryId, :visibleTitle);

insertGroupMember:
INSERT INTO source_migration_group_members(
    session_id,
    group_id,
    entry_id,
    position,
    source_id,
    title,
    url,
    thumbnail_url,
    selected
)
VALUES (
    :sessionId,
    :groupId,
    :entryId,
    :position,
    :sourceId,
    :title,
    :url,
    :thumbnailUrl,
    :selected
);

insertItem:
INSERT INTO source_migration_items(
    session_id,
    source_entry_id,
    position,
    source_id,
    source_title,
    source_url,
    source_thumbnail_url,
    state,
    included,
    operation_key,
    updated_at
)
VALUES (
    :sessionId,
    :sourceEntryId,
    :position,
    :sourceId,
    :sourceTitle,
    :sourceUrl,
    :sourceThumbnailUrl,
    :state,
    0,
    :operationKey,
    :updatedAt
);

insertCandidate:
INSERT INTO source_migration_candidates(
    session_id,
    source_entry_id,
    target_source_id,
    target_title,
    target_url,
    target_thumbnail_url,
    rank,
    score,
    match_kind,
    discovered_at
)
VALUES (
    :sessionId,
    :sourceEntryId,
    :targetSourceId,
    :targetTitle,
    :targetUrl,
    :targetThumbnailUrl,
    :rank,
    :score,
    :matchKind,
    :discoveredAt
);

insertDiscoveryFailure:
INSERT INTO source_migration_discovery_failures(
    session_id,
    source_entry_id,
    target_source_id,
    reason,
    retryable,
    detail,
    updated_at
)
VALUES (
    :sessionId,
    :sourceEntryId,
    :targetSourceId,
    :reason,
    :retryable,
    :detail,
    :updatedAt
);

clearCandidates:
DELETE FROM source_migration_candidates
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId;

clearDiscoveryFailures:
DELETE FROM source_migration_discovery_failures
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId;

transitionStage:
UPDATE source_migration_sessions
SET stage = :newStage,
    error_code = NULL,
    error_message = NULL,
    updated_at = :updatedAt,
    completed_at = :completedAt
WHERE session_id = :sessionId
AND stage = :expectedStage;

recordSessionFailure:
UPDATE source_migration_sessions
SET stage = :newStage,
    error_code = :errorCode,
    error_message = :errorMessage,
    updated_at = :updatedAt,
    completed_at = :completedAt
WHERE session_id = :sessionId;

requestCancellation:
UPDATE source_migration_sessions
SET cancellation_requested = 1,
    updated_at = :updatedAt
WHERE session_id = :sessionId;

clearCancellationRequest:
UPDATE source_migration_sessions
SET cancellation_requested = 0,
    updated_at = :updatedAt
WHERE session_id = :sessionId;

markItemSearching:
UPDATE source_migration_items
SET state = :state,
    discovery_attempts = discovery_attempts + 1,
    error_code = NULL,
    error_message = NULL,
    updated_at = :updatedAt
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId
AND state IN ('DISCOVERY_QUEUED', 'DISCOVERING');

queueItemDiscovery:
UPDATE source_migration_items
SET state = 'DISCOVERY_QUEUED',
    search_depth = :searchDepth,
    included = 0,
    selected_target_entry_id = NULL,
    target_source_id = NULL,
    target_title = NULL,
    target_url = NULL,
    target_thumbnail_url = NULL,
    match_kind = NULL,
    available_options = '',
    error_code = NULL,
    error_message = NULL,
    updated_at = :updatedAt
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId
AND state IN ('READY', 'NEEDS_REVIEW', 'NO_MATCH', 'DISCOVERY_FAILED', 'CONFLICT');

recordItemDiscovery:
UPDATE source_migration_items
SET state = :state,
    included = :included,
    selected_target_entry_id = :targetEntryId,
    target_source_id = :targetSourceId,
    target_title = :targetTitle,
    target_url = :targetUrl,
    target_thumbnail_url = :targetThumbnailUrl,
    match_kind = :matchKind,
    available_options = :availableOptions,
    error_code = :errorCode,
    error_message = :errorMessage,
    updated_at = :updatedAt
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId
AND state = 'DISCOVERING';

queueItemExecution:
UPDATE source_migration_items
SET state = 'EXECUTION_QUEUED',
    error_code = NULL,
    error_message = NULL,
    updated_at = :updatedAt
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId
AND included = 1
AND state = 'READY';

setItemIncluded:
UPDATE source_migration_items
SET included = :included,
    updated_at = :updatedAt
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId
AND state = 'READY';

selectItemTarget:
UPDATE source_migration_items
SET state = :state,
    included = :included,
    selected_target_entry_id = :targetEntryId,
    target_source_id = :targetSourceId,
    target_title = :targetTitle,
    target_url = :targetUrl,
    target_thumbnail_url = :targetThumbnailUrl,
    match_kind = :matchKind,
    available_options = :availableOptions,
    error_code = NULL,
    error_message = NULL,
    updated_at = :updatedAt
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId
AND state IN ('READY', 'NEEDS_REVIEW', 'NO_MATCH', 'DISCOVERY_FAILED', 'CONFLICT');

recordItemPlanningConflict:
UPDATE source_migration_items
SET state = 'CONFLICT',
    included = 0,
    error_code = :errorCode,
    error_message = NULL,
    updated_at = :updatedAt
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId
AND state = 'READY';

recordItemExecution:
UPDATE source_migration_items
SET state = :state,
    execution_attempts = execution_attempts + :attemptIncrement,
    error_code = :errorCode,
    error_message = :errorMessage,
    updated_at = :updatedAt
WHERE session_id = :sessionId
AND source_entry_id = :sourceEntryId;

deleteSession:
DELETE FROM source_migration_sessions
WHERE session_id = :sessionId;
