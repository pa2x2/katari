CREATE TABLE entry_translation_queue(
    chapter_id INTEGER NOT NULL PRIMARY KEY,
    entry_id INTEGER NOT NULL,
    position INTEGER NOT NULL,
    state TEXT NOT NULL CHECK(state IN ('waiting_for_download', 'queued', 'failed')),
    failure TEXT,
    setup TEXT NOT NULL,
    queued_at INTEGER NOT NULL,
    FOREIGN KEY(chapter_id) REFERENCES chapters(_id) ON DELETE CASCADE,
    FOREIGN KEY(entry_id) REFERENCES entries(_id) ON DELETE CASCADE
);

CREATE INDEX entry_translation_queue_entry_index ON entry_translation_queue(entry_id);
