-- The files sync carries on this device, custom covers and imported book fonts, one row per local owner: the content
-- the owner's record names and the content sync last saw in place. The two differ while a file waits to be fetched,
-- copied into place or removed. A row with neither is an owner known to have no file, which reading the owner's record
-- tells apart from an owner sync knows nothing about (no row), whose record keeps what it names.
CREATE TABLE sync_local_files(
    -- 'cover' or 'font'.
    category TEXT NOT NULL,
    -- The owner's local ref, as its record's: [entry id] for a custom cover, [profile id, file name] for a font.
    owner TEXT NOT NULL,
    -- SHA-256 of the content the owner's record names, as 64 lowercase hex digits; NULL for none.
    wanted_sha256 TEXT,
    -- In bytes.
    wanted_size INTEGER NOT NULL DEFAULT 0,
    -- SHA-256 of the file in place for the owner as sync last saw it; NULL for none.
    placed_sha256 TEXT,
    -- Epoch milliseconds when the server said it has no file of the wanted content; NULL while it may.
    unavailable_since INTEGER,
    PRIMARY KEY(category, owner)
);

CREATE INDEX idx_sync_local_files_placed ON sync_local_files(category, placed_sha256)
WHERE placed_sha256 IS NOT NULL;

-- Files this device holds that the server may lack. Each waits here until the server says it has it.
CREATE TABLE sync_file_uploads(
    category TEXT NOT NULL,
    sha256 TEXT NOT NULL,
    size INTEGER NOT NULL,
    PRIMARY KEY(category, sha256)
);

get:
SELECT *
FROM sync_local_files
WHERE category = :category AND owner = :owner;

-- The owner's record names :sha256 (NULL for no file); what is in place stays as it is until it is put there.
want:
INSERT INTO sync_local_files(category, owner, wanted_sha256, wanted_size)
VALUES (:category, :owner, :sha256, :size)
ON CONFLICT(category, owner) DO UPDATE SET
    unavailable_since = CASE
        WHEN wanted_sha256 IS excluded.wanted_sha256 THEN unavailable_since
        ELSE NULL
    END,
    wanted_sha256 = excluded.wanted_sha256,
    wanted_size = excluded.wanted_size;

-- The owner's record names no file; an owner sync knows nothing of stays unknown.
unwant:
UPDATE sync_local_files
SET wanted_sha256 = NULL, wanted_size = 0, unavailable_since = NULL
WHERE category = :category AND owner = :owner;

-- The file in place for the owner holds :sha256 (NULL for none), which its record names too.
holds:
INSERT INTO sync_local_files(category, owner, wanted_sha256, wanted_size, placed_sha256)
VALUES (:category, :owner, :sha256, :size, :sha256)
ON CONFLICT(category, owner) DO UPDATE SET
    wanted_sha256 = excluded.wanted_sha256,
    wanted_size = excluded.wanted_size,
    placed_sha256 = excluded.placed_sha256,
    unavailable_since = NULL;

-- The fonts of a profile and the covers of its entries, which sync is about to delete with the profile, are known to
-- be gone: their deletion is no edit of this device's.
releaseProfile:
UPDATE sync_local_files
SET wanted_sha256 = NULL, wanted_size = 0, placed_sha256 = NULL, unavailable_since = NULL
WHERE (category = 'font' AND owner LIKE :fontOwnerPrefix)
OR (category = 'cover' AND owner IN (SELECT '[' || _id || ']' FROM entries WHERE profile_id = :profileId));

setPlaced:
UPDATE sync_local_files
SET placed_sha256 = :sha256
WHERE category = :category AND owner = :owner;

delete:
DELETE FROM sync_local_files
WHERE category = :category AND owner = :owner;

-- Owners whose file in place isn't the one their record names.
unsettled:
SELECT *
FROM sync_local_files
WHERE wanted_sha256 IS NOT placed_sha256
ORDER BY category, wanted_sha256, owner;

placedAs:
SELECT *
FROM sync_local_files
WHERE category = :category AND placed_sha256 = :sha256;

markUnavailable:
UPDATE sync_local_files
SET unavailable_since = :at
WHERE category = :category AND wanted_sha256 = :sha256;

-- Files waiting to be fetched: named by a record, not in place, and not reported missing from the server.
downloadCount:
SELECT count(*) FROM (
    SELECT DISTINCT category, wanted_sha256
    FROM sync_local_files
    WHERE wanted_sha256 IS NOT NULL AND wanted_sha256 IS NOT placed_sha256 AND unavailable_since IS NULL
);

unavailableCount:
SELECT count(*) FROM (
    SELECT DISTINCT category, wanted_sha256
    FROM sync_local_files
    WHERE wanted_sha256 IS NOT NULL AND wanted_sha256 IS NOT placed_sha256 AND unavailable_since IS NOT NULL
);

-- A server that lost files may lack any of them: every file in place that its record names waits to be offered again.
queuePlaced:
INSERT OR IGNORE INTO sync_file_uploads(category, sha256, size)
SELECT DISTINCT category, placed_sha256, wanted_size
FROM sync_local_files
WHERE placed_sha256 IS NOT NULL AND placed_sha256 = wanted_sha256;

-- A server that lost files may have been filled again by other devices: ask for the missing ones again.
forgetUnavailable:
UPDATE sync_local_files
SET unavailable_since = NULL;

clear:
DELETE FROM sync_local_files;

queueUpload:
INSERT OR IGNORE INTO sync_file_uploads(category, sha256, size)
VALUES (:category, :sha256, :size);

uploads:
SELECT category, sha256, size
FROM sync_file_uploads
ORDER BY category, sha256
LIMIT :limit;

uploaded:
DELETE FROM sync_file_uploads
WHERE category = :category AND sha256 = :sha256;

uploadCount:
SELECT count(*)
FROM sync_file_uploads;

clearUploads:
DELETE FROM sync_file_uploads;

-- Entries whose custom covers may sync, all but local-source ones.
syncedEntryIds:
SELECT entries._id
FROM entries
JOIN source_identities ON source_identities.local_key = entries.source
WHERE source_identities.id_scheme != 'local';
