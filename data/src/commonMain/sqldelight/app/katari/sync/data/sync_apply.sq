import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;

-- How sync writes other devices' records into each synced table, the counterpart of sync_local_rows.sq. Only the
-- columns a record carries are written; the rest keep what this device holds or their defaults.

-- Profiles

profileId:
SELECT _id
FROM profiles
WHERE uuid = :uuid;

insertProfile:
INSERT INTO profiles(uuid, name, color_seed, position, requires_auth, is_archived, created_at, updated_at)
VALUES (:uuid, :name, :colorSeed, :position, 0, :isArchived, strftime('%s', 'now'), strftime('%s', 'now'));

updateProfile:
UPDATE profiles
SET name = :name, color_seed = :colorSeed, position = :position, is_archived = :isArchived
WHERE uuid = :uuid;

setProfileUuid:
UPDATE profiles
SET uuid = :uuid
WHERE _id = :profileId;

-- Entries

entryId:
SELECT _id
FROM entries
WHERE profile_id = :profileId AND source = :source AND url = :url AND type = :type;

entryExists:
SELECT count(*) > 0
FROM entries
WHERE _id = :entryId;

entryProfile:
SELECT profile_id
FROM entries
WHERE _id = :entryId;

insertEntry:
INSERT INTO entries(
    profile_id, source, url, type, title, author, artist, description, genre, status, thumbnail_url, background_url,
    favorite, date_added, display_name, notes, library_pinned, viewer, chapter_flags, download_title
)
VALUES (
    :profileId, :source, :url, :type, :title, :author, :artist, :description, :genre, :status, :thumbnailUrl,
    :backgroundUrl, :favorite, :dateAdded, :displayName, :notes, :libraryPinned, :viewer, :chapterFlags, :title
)
RETURNING _id;

updateEntry:
UPDATE entries
SET favorite = :favorite,
    date_added = :dateAdded,
    display_name = :displayName,
    notes = :notes,
    library_pinned = :libraryPinned,
    viewer = :viewer,
    chapter_flags = :chapterFlags
WHERE _id = :entryId;

moveEntry:
UPDATE entries
SET profile_id = :profileId
WHERE _id = :entryId;

deleteEntry:
DELETE FROM entries
WHERE _id = :entryId;

-- Chapters

chapterId:
SELECT _id
FROM chapters
WHERE entry_id = :entryId AND url = :url;

chapterExists:
SELECT count(*) > 0
FROM chapters
WHERE _id = :chapterId;

chapterEntry:
SELECT entry_id
FROM chapters
WHERE _id = :chapterId;

-- The fields local migration matches chapters by.
chaptersOfEntry:
SELECT _id, url, name, chapter_number
FROM chapters
WHERE entry_id = :entryId;

-- After the entry's other chapters, in a place none of them holds until a refresh places it: chapters sharing a place
-- read to a refresh as copies of one chapter.
insertChapter:
INSERT INTO chapters(entry_id, url, name, read, bookmark, chapter_number, scanlator, date_upload, date_fetch, source_order)
VALUES (
    :entryId, :url, :name, :read, :bookmark, :chapterNumber, :scanlator, :dateUpload,
    CAST(round((julianday('now') - 2440587.5) * 86400000) AS INTEGER),
    (SELECT coalesce(max(source_order) + 1, 0) FROM chapters WHERE entry_id = :entryId)
)
RETURNING _id;

updateChapterMarks:
UPDATE chapters
SET read = :read, bookmark = :bookmark
WHERE _id = :chapterId;

-- Reading and playback positions. The update times are when the device that made them did, so the newest
-- position is the same one on every device.

upsertProgress:
INSERT INTO entry_progress_state(
    entry_id, chapter_id, content_key, resource_key, resource_revision, locator_kind, position, extent, progression,
    total_progression, extensions, completed, locator_updated_at, completion_updated_at
)
VALUES (
    :entryId, :chapterId, :contentKey, :resourceKey, :resourceRevision, :locatorKind, :position, :extent,
    :progression, :totalProgression, :extensions, :completed, :locatorUpdatedAt, :completionUpdatedAt
)
ON CONFLICT(entry_id, content_key, resource_key) DO UPDATE SET
    chapter_id = excluded.chapter_id,
    resource_revision = excluded.resource_revision,
    locator_kind = excluded.locator_kind,
    position = excluded.position,
    extent = excluded.extent,
    progression = excluded.progression,
    total_progression = excluded.total_progression,
    extensions = excluded.extensions,
    completed = excluded.completed,
    locator_updated_at = excluded.locator_updated_at,
    completion_updated_at = excluded.completion_updated_at;

progressId:
SELECT _id
FROM entry_progress_state
WHERE entry_id = :entryId AND content_key = :contentKey AND resource_key = :resourceKey;

deleteProgress:
DELETE FROM entry_progress_state
WHERE _id = :id;

-- History

upsertHistory:
INSERT INTO history(entry_id, chapter_id, last_read, time_read)
VALUES (:entryId, :chapterId, :lastRead, :timeRead)
ON CONFLICT(chapter_id) DO UPDATE SET
    entry_id = excluded.entry_id,
    last_read = excluded.last_read,
    time_read = excluded.time_read;

deleteHistory:
DELETE FROM history
WHERE chapter_id = :chapterId;

-- Activity

upsertActivitySession:
INSERT INTO activity_sessions(session_id, entry_id, started_at, ended_at, duration)
VALUES (:sessionId, :entryId, :startedAt, :endedAt, :duration)
ON CONFLICT(session_id) DO UPDATE SET
    entry_id = excluded.entry_id,
    started_at = excluded.started_at,
    ended_at = excluded.ended_at,
    duration = excluded.duration;

activitySessionExists:
SELECT count(*) > 0
FROM activity_sessions
WHERE session_id = :sessionId;

-- chapter_id is part of the key and may be null, which SQLite never counts as a conflict, so the row is replaced.
deleteActivitySegment:
DELETE FROM activity_segments
WHERE session_id = :sessionId
AND chapter_id IS :chapterId
AND local_date = :localDate
AND time_zone_id = :timeZoneId;

insertActivitySegment:
INSERT INTO activity_segments(session_id, chapter_id, local_date, time_zone_id, started_at, ended_at, duration)
VALUES (:sessionId, :chapterId, :localDate, :timeZoneId, :startedAt, :endedAt, :duration);

insertActivityCompletion:
INSERT OR IGNORE INTO activity_completion_events(
    event_id, entry_id, chapter_id, session_id, occurred_at, local_date, time_zone_id, cause
)
VALUES (:eventId, :entryId, :chapterId, :sessionId, :occurredAt, :localDate, :timeZoneId, :cause);

upsertStatisticsEpoch:
INSERT INTO statistics_epochs(profile_id, started_at)
VALUES (:profileId, :startedAt)
ON CONFLICT(profile_id) DO UPDATE SET started_at = excluded.started_at;

-- Categories

categoryExists:
SELECT count(*) > 0
FROM categories
WHERE _id = :categoryId AND _id != 0;

categoriesNamed:
SELECT _id
FROM categories
WHERE profile_id = :profileId AND name = :name AND _id != 0;

insertCategory:
INSERT INTO categories(profile_id, name, sort, flags)
VALUES (:profileId, :name, :sort, :flags)
RETURNING _id;

updateCategory:
UPDATE categories
SET name = :name, sort = :sort, flags = :flags
WHERE _id = :categoryId;

deleteCategory:
DELETE FROM categories
WHERE _id = :categoryId AND _id != 0;

membershipExists:
SELECT count(*) > 0
FROM entries_categories
WHERE entry_id = :entryId AND category_id = :categoryId;

insertMembership:
INSERT INTO entries_categories(profile_id, entry_id, category_id)
VALUES (:profileId, :entryId, :categoryId);

deleteMembership:
DELETE FROM entries_categories
WHERE entry_id = :entryId AND category_id = :categoryId;

upsertCategoryUpdateRules:
INSERT INTO category_update_rules(
    profile_id, category_id, auto_update, custom_rules, skip_completed, skip_unseen, skip_not_started,
    skip_outside_release_period, interval_hours
)
VALUES (
    :profileId, :categoryId, :autoUpdate, :customRules, :skipCompleted, :skipUnseen, :skipNotStarted,
    :skipOutsideReleasePeriod, :intervalHours
)
ON CONFLICT(profile_id, category_id) DO UPDATE SET
    auto_update = excluded.auto_update,
    custom_rules = excluded.custom_rules,
    skip_completed = excluded.skip_completed,
    skip_unseen = excluded.skip_unseen,
    skip_not_started = excluded.skip_not_started,
    skip_outside_release_period = excluded.skip_outside_release_period,
    interval_hours = excluded.interval_hours;

deleteCategoryUpdateRules:
DELETE FROM category_update_rules
WHERE profile_id = :profileId AND category_id = :categoryId;

-- An entry's own choices

upsertEntryUpdateMode:
INSERT INTO entry_update_modes(entry_id, mode)
VALUES (:entryId, :mode)
ON CONFLICT(entry_id) DO UPDATE SET mode = excluded.mode;

deleteEntryUpdateMode:
DELETE FROM entry_update_modes
WHERE entry_id = :entryId;

excludedScanlatorExists:
SELECT count(*) > 0
FROM excluded_scanlators
WHERE entry_id = :entryId AND scanlator = :scanlator;

insertExcludedScanlator:
INSERT INTO excluded_scanlators(profile_id, entry_id, scanlator)
VALUES (:profileId, :entryId, :scanlator);

deleteExcludedScanlator:
DELETE FROM excluded_scanlators
WHERE entry_id = :entryId AND scanlator = :scanlator;

upsertViewerSetting:
INSERT INTO viewer_setting_overrides(entry_id, provider_id, setting_key, encoded_value, updated_at)
VALUES (
    :entryId, :providerId, :settingKey, :encodedValue,
    CAST(round((julianday('now') - 2440587.5) * 86400000) AS INTEGER)
)
ON CONFLICT(entry_id, provider_id, setting_key) DO UPDATE SET
    encoded_value = excluded.encoded_value,
    updated_at = excluded.updated_at;

deleteViewerSetting:
DELETE FROM viewer_setting_overrides
WHERE entry_id = :entryId AND provider_id = :providerId AND setting_key = :settingKey;

upsertDownloadPreferences:
INSERT INTO download_preferences(
    entry_id, dub_key, stream_key, subtitle_key, quality_mode, server_key, audio_key, updated_at
)
VALUES (
    :entryId, :dubKey, :streamKey, :subtitleKey, :qualityMode, :serverKey, :audioKey,
    CAST(round((julianday('now') - 2440587.5) * 86400000) AS INTEGER)
)
ON CONFLICT(entry_id) DO UPDATE SET
    dub_key = excluded.dub_key,
    stream_key = excluded.stream_key,
    subtitle_key = excluded.subtitle_key,
    quality_mode = excluded.quality_mode,
    server_key = excluded.server_key,
    audio_key = excluded.audio_key,
    updated_at = excluded.updated_at;

deleteDownloadPreferences:
DELETE FROM download_preferences
WHERE entry_id = :entryId;

upsertTranslationLanguages:
INSERT INTO entry_translation_languages(
    entry_id, content_language, target_language, translate_downloads, updated_at
)
VALUES (
    :entryId, :contentLanguage, :targetLanguage, :translateDownloads,
    CAST(round((julianday('now') - 2440587.5) * 86400000) AS INTEGER)
)
ON CONFLICT(entry_id) DO UPDATE SET
    content_language = excluded.content_language,
    target_language = excluded.target_language,
    translate_downloads = excluded.translate_downloads,
    updated_at = excluded.updated_at;

deleteTranslationLanguages:
DELETE FROM entry_translation_languages
WHERE entry_id = :entryId;

upsertIntroTimesPick:
INSERT INTO intro_times_matches(entry_id, group_key, anilist_id, mal_id, title, year, picked_by_user, checked_at)
VALUES (
    :entryId, :groupKey, :anilistId, :malId, :title, :year, 1,
    CAST(round((julianday('now') - 2440587.5) * 86400000) AS INTEGER)
)
ON CONFLICT(entry_id, group_key) DO UPDATE SET
    anilist_id = excluded.anilist_id,
    mal_id = excluded.mal_id,
    title = excluded.title,
    year = excluded.year,
    picked_by_user = 1,
    checked_at = excluded.checked_at;

-- An automatic match is this device's own and stays.
deleteIntroTimesPick:
DELETE FROM intro_times_matches
WHERE entry_id = :entryId AND group_key = :groupKey AND picked_by_user = 1;

upsertPlaybackPreferences:
INSERT INTO playback_preferences(
    entry_id, dub_key, stream_key, source_quality_key, subtitle_key, player_quality_mode, player_quality_height,
    subtitle_offset_x, subtitle_offset_y, subtitle_text_size, subtitle_text_color, subtitle_background_color,
    subtitle_background_opacity, subtitle_text_edge, player_engine, server_key, updated_at
)
VALUES (
    :entryId, :dubKey, :streamKey, :sourceQualityKey, :subtitleKey, :playerQualityMode, :playerQualityHeight,
    :subtitleOffsetX, :subtitleOffsetY, :subtitleTextSize, :subtitleTextColor, :subtitleBackgroundColor,
    :subtitleBackgroundOpacity, :subtitleTextEdge, :playerEngine, :serverKey,
    CAST(round((julianday('now') - 2440587.5) * 86400000) AS INTEGER)
)
ON CONFLICT(entry_id) DO UPDATE SET
    dub_key = excluded.dub_key,
    stream_key = excluded.stream_key,
    source_quality_key = excluded.source_quality_key,
    subtitle_key = excluded.subtitle_key,
    player_quality_mode = excluded.player_quality_mode,
    player_quality_height = excluded.player_quality_height,
    subtitle_offset_x = excluded.subtitle_offset_x,
    subtitle_offset_y = excluded.subtitle_offset_y,
    subtitle_text_size = excluded.subtitle_text_size,
    subtitle_text_color = excluded.subtitle_text_color,
    subtitle_background_color = excluded.subtitle_background_color,
    subtitle_background_opacity = excluded.subtitle_background_opacity,
    subtitle_text_edge = excluded.subtitle_text_edge,
    player_engine = excluded.player_engine,
    server_key = excluded.server_key,
    updated_at = excluded.updated_at;

deletePlaybackPreferences:
DELETE FROM playback_preferences
WHERE entry_id = :entryId;

-- Trackers

upsertTrackerBinding:
INSERT INTO entry_sync(
    profile_id, entry_id, sync_id, remote_id, library_id, title, last_chapter_read, total_chapters, status, score,
    remote_url, start_date, finish_date, private
)
VALUES (
    :profileId, :entryId, :trackerId, :remoteId, :libraryId, :title, :lastChapterRead, :totalChapters, :status,
    :score, :remoteUrl, :startDate, :finishDate, :private
);

deleteTrackerBinding:
DELETE FROM entry_sync
WHERE entry_id = :entryId AND sync_id = :trackerId;

-- Merges the person made

deleteMergeMember:
DELETE FROM merged_entries
WHERE profile_id = :profileId AND entry_id = :entryId;

-- A member already at the position, from a merge applied in another order, gives way; its own record puts it back.
insertMergeMember:
INSERT OR REPLACE INTO merged_entries(profile_id, target_entry_id, entry_id, position)
VALUES (:profileId, :targetEntryId, :entryId, :position);

-- Extension repositories

insertExtensionRepository:
INSERT OR IGNORE INTO extension_store(
    index_url, name, badge_label, signing_key, contact_website, contact_discord, format, extension_list_url
)
VALUES (
    :indexUrl, :name, :badgeLabel, :signingKey, :contactWebsite, :contactDiscord, :format, :extensionListUrl
);

deleteExtensionRepository:
DELETE FROM extension_store
WHERE index_url = :indexUrl;

-- Moving an entry's rows to another entry, for a move to another profile whose target row exists already. Rows the
-- target has of its own stay, so the moved ones that would clash are dropped.

-- A position names its chapter together with its entry, so chapters can't change entry while positions point at them,
-- and positions can't follow before their chapters have: positions let go of their chapters during the move and take
-- them back by URL afterwards, which also finds the target's own chapter where the moved one clashed.

progressChapterLinks:
SELECT _id, chapter_id
FROM entry_progress_state
WHERE entry_id = :entryId AND chapter_id IS NOT NULL;

detachProgressChapters:
UPDATE entry_progress_state
SET chapter_id = NULL
WHERE entry_id = :entryId;

relinkProgressChapter:
UPDATE entry_progress_state
SET chapter_id = (
    SELECT C._id
    FROM chapters C JOIN chapters Linked ON Linked.url = C.url
    WHERE Linked._id = :chapterId AND C.entry_id = entry_progress_state.entry_id
)
WHERE _id = :progressId;

moveChapters:
UPDATE OR IGNORE chapters
SET entry_id = :toEntryId
WHERE entry_id = :fromEntryId;

moveProgress:
UPDATE OR IGNORE entry_progress_state
SET entry_id = :toEntryId
WHERE entry_id = :fromEntryId;

moveHistory:
UPDATE history
SET entry_id = :toEntryId
WHERE entry_id = :fromEntryId;

moveActivitySessions:
UPDATE activity_sessions
SET entry_id = :toEntryId
WHERE entry_id = :fromEntryId;

moveActivityCompletions:
UPDATE activity_completion_events
SET entry_id = :toEntryId
WHERE entry_id = :fromEntryId;
