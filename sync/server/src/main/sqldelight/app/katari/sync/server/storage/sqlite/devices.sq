import kotlin.Boolean;

CREATE TABLE devices(
    -- The device's DeviceId, picked at random over all 64 bits.
    _id INTEGER NOT NULL PRIMARY KEY,
    account_id INTEGER NOT NULL REFERENCES accounts(_id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    platform TEXT NOT NULL,
    app_version TEXT NOT NULL,
    -- SHA-256 of the device's bearer token; the token itself is never stored.
    token_hash BLOB NOT NULL UNIQUE,
    registered_at INTEGER NOT NULL,
    last_seen_at INTEGER NOT NULL,
    -- The position the device last pulled from, null until its first pull.
    synced_up_to INTEGER,
    -- A revoked device keeps its row, so its id is never given out again and its token is answered as revoked.
    is_revoked INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE INDEX devices_account_index ON devices(account_id);

countWithId:
SELECT count(*)
FROM devices
WHERE _id = :id;

insert:
INSERT INTO devices(_id, account_id, name, platform, app_version, token_hash, registered_at, last_seen_at)
VALUES (:id, :accountId, :name, :platform, :appVersion, :tokenHash, :registeredAt, :registeredAt);

byTokenHash:
SELECT *
FROM devices
WHERE token_hash = :tokenHash;

byId:
SELECT *
FROM devices
WHERE _id = :id;

activeInAccount:
SELECT *
FROM devices
WHERE account_id = :accountId AND is_revoked = 0
ORDER BY registered_at, _id;

touch:
UPDATE devices
SET last_seen_at = max(last_seen_at, :seenAt)
WHERE _id = :id;

setSyncedUpTo:
UPDATE devices
SET synced_up_to = :position
WHERE _id = :id;

revoke:
UPDATE devices
SET is_revoked = 1
WHERE _id = :id;

oldestHeldPosition:
SELECT min(synced_up_to) AS position
FROM devices
WHERE account_id = :accountId
    AND is_revoked = 0
    AND synced_up_to IS NOT NULL
    AND last_seen_at >= :seenSince;
