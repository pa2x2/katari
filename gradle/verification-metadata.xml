<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pins the AARs and jars Gradle downloads from GitHub releases (see settings.gradle.kts): the reduced ONNX Runtime AAR
  and Linux jar that tools/onnxruntime/build.sh made and verified, the desktop app's libarchive and libmpv that
  tools/libarchive/build-jar.sh and tools/libmpv/build-jar.sh made and verified, and libmpv, quickjs-kt and
  image-decoder as released from pa2x2/mpv-android, pa2x2/quickjs-kt and pa2x2/image-decoder (each release's
  SHA256SUMS). Also pins JCEF's API from
  JetBrains' intellij-dependencies repository (the .sha256 files it publishes beside each file). Every other
  dependency comes from a repository Gradle already trusts and stays unchecked, and so do the sources and javadoc
  jars an IDE downloads for display, since nothing builds or runs them.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!app[.]katari[.](onnxruntime|libarchive|libmpv)$|io[.]github[.]pa2x2$|org[.]jetbrains[.]intellij[.]deps[.]jcef$).*$" regex="true"/>
         <trust file=".*-sources[.]jar" regex="true"/>
         <trust file=".*-javadoc[.]jar" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="org.jetbrains.intellij.deps.jcef" name="jcef" version="150.0.14-g7c1aa68-chromium-150.0.7871.129-api-1.21-263-b16">
