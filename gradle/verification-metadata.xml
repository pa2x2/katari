<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pins the AARs Gradle downloads from GitHub releases (see settings.gradle.kts): the reduced ONNX Runtime that
  tools/onnxruntime/build-aar.sh made and verified, and libmpv and quickjs-kt as released
  from pa2x2/mpv-android and pa2x2/quickjs-kt (each release's SHA256SUMS). Also pins JCEF's API from JetBrains'
  intellij-dependencies repository (the .sha256 files it publishes beside each file). Every other dependency comes
  from a repository Gradle already trusts and stays unchecked.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!app[.]katari[.](onnxruntime|libmpv)$|io[.]github[.]pa2x2$|org[.]jetbrains[.]intellij[.]deps[.]jcef$).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="org.jetbrains.intellij.deps.jcef" name="jcef" version="150.0.14-g7c1aa68-chromium-150.0.7871.129-api-1.21-263-b16">
         <artifact name="jcef-150.0.14-g7c1aa68-chromium-150.0.7871.129-api-1.21-263-b16.jar">
            <sha256 value="beea36b3c2a831165c9b68ae5313b0ade6c3a8f0ffd33f3c001c2ddc450ad195" origin="intellij-dependencies .sha256"/>
         </artifact>
         <artifact name="jcef-150.0.14-g7c1aa68-chromium-150.0.7871.129-api-1.21-263-b16.pom">
            <sha256 value="5cad8197d5056c3bcc0fb10b21db9c1a8637aa224b8a080893ba15cac9fd0fc5" origin="intellij-dependencies .sha256"/>
         </artifact>
      </component>
      <component group="io.github.pa2x2" name="quickjs-kt-android" version="1.0.15-fork.2">
         <artifact name="quickjs-kt-android-1.0.15-fork.2.aar">
            <sha256 value="1ed2fa754c5d3f22052a4f08c72b8da143de0158c23b0be074d3ca29e1d9b9c1" origin="quickjs-kt-1.0.15-fork.2-SHA256SUMS.txt"/>
         </artifact>
      </component>
      <component group="io.github.pa2x2" name="quickjs-kt-jvm" version="1.0.15-fork.2">
         <artifact name="quickjs-kt-jvm-1.0.15-fork.2.jar">
            <sha256 value="b94064f3ca40ea9bf16cbdd7995e78143a0610dfc9a7dd0f3e7993a33e6b74f6" origin="quickjs-kt-1.0.15-fork.2-SHA256SUMS.txt"/>
         </artifact>
      </component>
      <component group="app.katari.libmpv" name="libmpv-android" version="2026-10-23-3">
         <artifact name="libmpv-android-2026-10-23-3.aar">
            <sha256 value="a2e40feb4661ae0004a95985f622d690fb9a236a5bb16495de45c52efab2d914" origin="libmpv-android-2026-10-23-3-SHA256SUMS.txt"/>
         </artifact>
      </component>
      <component group="app.katari.onnxruntime" name="onnxruntime-android" version="1.31.0">
         <artifact name="onnxruntime-android-1.31.0.aar">
